{
  "uid": "9bad4757-d985-446d-914b-76ffb221f3db",
  "name": "Core Dumps Disabled via Resource Limits",
  "former_names": [
    "CIS - Core Dumps Disabled"
  ],
  "description": "Ensures a hard core-file size limit of 0 is set for all users ('* hard core 0' in /etc/security/limits.conf or limits.d), preventing core dumps that may contain sensitive memory.",
  "active": true,
  "category": "system_hardening",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/security/limits.conf /etc/security/limits.d/*.conf 2>/dev/null",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^[ \\t]*\\*[ \\t]+hard[ \\t]+core[ \\t]+0\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],

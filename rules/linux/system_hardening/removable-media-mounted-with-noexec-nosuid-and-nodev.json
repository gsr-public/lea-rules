{
  "uid": "22423414-157f-44a8-be58-7259fadb5b10",
  "name": "Removable Media Mounted with noexec, nosuid and nodev",
  "description": "Ensures every currently mounted removable or optical filesystem (vfat, exfat, ntfs, iso9660, udf under /media, /mnt or /run/media) carries nodev, nosuid and noexec. Passes when no removable media is mounted.",
  "active": true,
  "category": "system_hardening",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /proc/mounts",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\S"
        },
        "not_re": {
          "stdout": "(?m)^\\S+[ \\t]+/(?:media|mnt|run/media)/\\S*[ \\t]+(?:vfat|exfat|ntfs3?|iso9660|udf|fuseblk)[ \\t]+(?:(?![^ \\t\\n]*\\bnodev\\b)|(?![^ \\t\\n]*\\bnosuid\\b)|(?![^ \\t\\n]*\\bnoexec\\b))\\S"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:10.3",
    "std:NIST_800-53:MP-7",
    "std:ISO27001:A.7.10",
    "std:SOC2:CC6.8",
    "std:CMMC:MP.L2-3.8.7",
    "std:NIS2:Art21.2(e)",
    "std:DORA:Art9",
    "std:HIPAA:164.310(d)(1)",
    "std:NIST_CSF_2:PR.DS-01",
    "cat:system_hardening",
    "env:linux",
    "env:host_level",
    "risk:low"
  ]
}

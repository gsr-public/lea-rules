{
  "name": "Linux System Clock Synchronized",
  "description": "Verifies that the system is synchronized with a reliable time source (NTP or equivalent).",
  "active": true,
  "category": "system_hardening",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "timedatectl status",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "System clock synchronized:\\s+yes"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:8.4",
    "std:NIST_800-53:AU-8",
    "std:ISO27001:A.8.17",
    "std:ISO27001:A.12.4.4",
    "std:SOC2:CC7.2",
    "std:CMMC:AU.L2-3.3.7",
    "std:PCI_DSS_4:10.6.1",
    "std:HIPAA:164.312(b)",
    "std:NIST_CSF_2:PR.PS-04",
    "cat:system_hardening",
    "env:linux",
    "env:host_level",
    "risk:low"
  ]
}

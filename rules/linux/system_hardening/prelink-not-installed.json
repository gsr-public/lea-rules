  "uid": "3497c104-03d0-4206-993d-40e497ebe319",
  "name": "prelink Not Installed",
  "description": "Ensures prelink, which rewrites binaries and breaks file integrity monitoring baselines, is not installed (/usr/sbin/prelink, /usr/bin/prelink absent).",
  "active": true,
  "category": "system_hardening",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "ls -l /usr/sbin/prelink /usr/bin/prelink 2>&1",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\S"
        },
        "not_re": {
          "stdout": "(?m)^[-l][rwxsStT-]{9}"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },

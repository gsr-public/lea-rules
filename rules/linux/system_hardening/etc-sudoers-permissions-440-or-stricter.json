{
  "uid": "f24e2d2c-c6cf-4cb3-9945-40f18f31bc12",
  "name": "/etc/sudoers Permissions 440 or Stricter",
  "description": "Verifies that /etc/sudoers is owned by root:root with mode 440 or 400. Passes with LEA_RULE_no_service when sudo is not installed.",
  "active": true,
  "category": "system_hardening",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "stat -c '%a %U %G' /etc/sudoers 2>/dev/null || echo 'LEA_RULE_no_service'",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\A(?:440|400) root root\\s*\\Z|LEA_RULE_no_service"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],

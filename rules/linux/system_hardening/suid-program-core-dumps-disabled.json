{
  "name": "SUID Program Core Dumps Disabled",
  "description": "Ensures set-UID programs cannot produce core dumps (fs.suid_dumpable = 0), which could otherwise expose privileged memory such as password hashes.\nRequired sudo rule (remedy only): allow user lea to run ONLY this exact command without a password: lea ALL=(root) NOPASSWD: /sbin/sysctl -w fs.suid_dumpable=0",
  "active": true,
  "category": "system_hardening",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /proc/sys/fs/suid_dumpable",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "^0$"
        }
      }
    ],
    "remedy": [
      {
        "command": "sysctl -w fs.suid_dumpable=0 >/dev/null && cat /proc/sys/fs/suid_dumpable",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.1",
    "std:NIST_800-53:CM-6",
    "std:NIST_800-53:SI-11",
    "std:ISO27001:A.8.9",
    "std:SOC2:CC7.1",
    "std:CMMC:CM.L2-3.4.2",
    "std:PCI_DSS_4:2.2.6",
    "std:NIS2:Art21.2(e)",
    "std:DORA:Art9",
    "cat:system_hardening",
    "env:linux",
    "env:host_level",
    "risk:medium"
  ]
}

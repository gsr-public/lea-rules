  "name": "FTP Client Not Installed",
  "description": "Ensures the FTP client is not installed (/usr/bin/ftp, /usr/bin/tnftp absent). Removing unused clear-text or legacy tools reduces the attack surface and the risk of credentials being sent unencrypted.",
  "active": true,
  "category": "system_hardening",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "ls -l /usr/bin/ftp /usr/bin/tnftp 2>&1",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\S"
        },
        "not_re": {
          "stdout": "(?m)^[-l][rwxsStT-]{9}"
        }
      }
    ],

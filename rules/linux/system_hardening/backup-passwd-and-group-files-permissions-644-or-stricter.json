{
  "name": "Backup passwd and group Files Permissions 644 or Stricter",
  "description": "Ensures the backup account files /etc/passwd- and /etc/group- are owned by root:root and not writable by group or others. Passes with LEA_RULE_no_service when neither backup exists.",
  "active": true,
  "category": "system_hardening",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "stat -c '%n %a %U %G' /etc/passwd- /etc/group- 2>/dev/null || echo 'LEA_RULE_no_service'",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\S"
        },
        "not_re": {
          "stdout": "(?m)^(?!LEA_RULE_no_service)\\S+ (?!(?:[46][04][04] root root)$)"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:3.3",
    "std:NIST_800-53:AC-3",
    "std:ISO27001:A.8.3",
    "std:SOC2:CC6.1",
    "std:CMMC:AC.L2-3.1.1",
    "std:PCI_DSS_4:2.2.6",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.312(a)(1)",
    "std:NIST_CSF_2:PR.AA-05",
    "cat:system_hardening",
    "env:linux",
    "env:host_level",
    "risk:medium"
  ]
}

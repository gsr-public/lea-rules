{
  "name": "No Ungrouped Files on Local Filesystems",
  "description": "Ensures there are no files or directories on the root filesystem whose group does not exist, which typically indicates leftovers of deleted accounts that a new group could inherit.",
  "active": true,
  "category": "system_hardening",
  "cycle": 43200,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "find / -xdev -nogroup 2>/dev/null",

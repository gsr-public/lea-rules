{
  "uid": "4fce7c2e-173c-46b3-8f31-75526a43d774",
  "name": "Backup shadow and gshadow Files Permissions Restricted",
  "description": "Ensures the backup password hash files /etc/shadow- and /etc/gshadow- are owned by root, group root or shadow, with mode 0, 400, 440, 600 or 640. Passes with LEA_RULE_no_service when neither backup exists.",
  "active": true,
  "category": "system_hardening",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "stat -c '%n %a %U %G' /etc/shadow- /etc/gshadow- 2>/dev/null || echo 'LEA_RULE_no_service'",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\S"
        },
        "not_re": {
          "stdout": "(?m)^(?!LEA_RULE_no_service)\\S+ (?!(?:(?:0|[46][04]0) root (?:root|shadow))$)"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:3.3",

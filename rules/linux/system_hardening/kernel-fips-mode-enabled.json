{
  "name": "Kernel FIPS Mode Enabled",
  "description": "Checks that the kernel runs in FIPS mode (/proc/sys/crypto/fips_enabled = 1), restricting kernel and, on most distributions, user-space cryptography to FIPS 140 approved algorithms. Apply only to environments that must use FIPS-validated cryptography (for example CMMC or FedRAMP scope).",
  "active": true,
  "category": "system_hardening",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {

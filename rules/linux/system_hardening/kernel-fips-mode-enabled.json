      {
        "command": "cat /proc/sys/crypto/fips_enabled",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\A1\\b"
        }
      }
    ],
    "remedy": [],
    "system": []
  },

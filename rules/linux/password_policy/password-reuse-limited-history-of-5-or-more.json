{
  "name": "Password Reuse Limited (History of 5 or More)",
  "description": "Checks that password reuse is restricted by remembering at least the last 5 passwords (pam_pwhistory or pam_unix 'remember' option in the PAM password stack, or 'remember' in /etc/security/pwhistory.conf).",
  "active": true,
  "category": "password_policy",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/pam.d/common-password /etc/security/pwhistory.conf 2>/dev/null",
        "system": [
          "Linux"
        ],
        "distribution": [
          "Ubuntu",
          "Debian GNU/Linux"
        ]
      },
      {
        "command": "cat /etc/pam.d/system-auth /etc/security/pwhistory.conf 2>/dev/null",
        "system": [
          "Linux"
        ],
        "distribution": [
          "Red Hat Enterprise Linux",
          "CentOS Linux",
          "CentOS Stream",
          "Fedora Linux",
          "Oracle Linux Server",
          "Amazon Linux",
          "Rocky Linux",
          "AlmaLinux"
        ]
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [
          "Ubuntu",
          "Debian GNU/Linux"
        ],
        "re": {
          "stdout": "(?m)^[ \\t]*(?:[^#\\s][^\\n]*)?\\bremember[ \\t]*=[ \\t]*(?:[5-9]|[1-9]\\d)\\b"
        }
      },
      {
        "system": [
          "Linux"
        ],
        "distribution": [
          "Red Hat Enterprise Linux",
          "CentOS Linux",
          "CentOS Stream",
          "Fedora Linux",
          "Oracle Linux Server",
          "Amazon Linux",
          "Rocky Linux",
          "AlmaLinux"
        ],
        "re": {
          "stdout": "(?m)^[ \\t]*(?:[^#\\s][^\\n]*)?\\bremember[ \\t]*=[ \\t]*(?:[5-9]|[1-9]\\d)\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:5.2",
    "std:NIST_800-53:IA-5",
    "std:ISO27001:A.5.17",
    "std:SOC2:CC6.1",
    "std:CMMC:IA.L2-3.5.8",
    "std:PCI_DSS_4:8.3.7",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(5)(ii)(D)",
    "std:HIPAA:164.312(d)",
    "std:NIST_CSF_2:PR.AA-01",
    "cat:password_policy",
    "env:linux",
    "env:host_level",
    "risk:medium"
  ]
}

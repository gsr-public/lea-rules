        "system": [
          "Linux"
        ],
        "distribution": [
          "Ubuntu",
          "Debian GNU/Linux"
        ],
        "re": {
          "stdout": "(?m)^[ \\t]*password[ \\t]+(?:requisite|required|\\[[^\\]\\n]*\\])[ \\t]+pam_pwquality\\.so\\b"

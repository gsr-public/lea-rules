{
  "uid": "46e60877-5e99-4d07-8369-b464c96fce10",
  "name": "PAM Password Quality Module Enabled (pam_pwquality)",
  "description": "Ensures pam_pwquality is part of the password stack, so the quality rules in pwquality.conf are actually applied when passwords change.",
  "active": true,
  "category": "password_policy",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/pam.d/common-auth /etc/pam.d/common-password /etc/pam.d/common-account 2>/dev/null",
        "system": [
          "Linux"
        ],
        "distribution": [
          "Ubuntu",
          "Debian GNU/Linux"
        ]
      },
      {
        "command": "cat /etc/pam.d/system-auth /etc/pam.d/password-auth 2>/dev/null",
        "system": [
          "Linux"
        ],
        "distribution": [
          "Red Hat Enterprise Linux",
          "CentOS Linux",
          "CentOS Stream",
          "Fedora Linux",
          "Oracle Linux Server",
          "Amazon Linux",
          "Rocky Linux",
          "AlmaLinux"
        ]
      }
    ],

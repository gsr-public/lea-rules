{
  "name": "Password Expiration Applied to Existing Accounts (365 Days or Less)",
  "description": "Ensures every account with a password hash in /etc/shadow has a maximum password age between 1 and 365 days. login.defs only applies to accounts created later, so existing accounts must be checked directly.\nRequired sudo rule: allow user lea to run ONLY this exact command without a password: lea ALL=(root) NOPASSWD: /bin/cat /etc/shadow",
  "active": true,
  "category": "password_policy",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/shadow",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^root:"
        },
        "not_re": {
          "stdout": "(?m)^[^:\\n]+:\\$[^:\\n]+:[^:\\n]*:[^:\\n]*:(?!(?:[1-9]|[1-9]\\d|[12]\\d{2}|3[0-5]\\d|36[0-5]):)[^:\\n]*:"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:5.2",
    "std:NIST_800-53:IA-5",
    "std:ISO27001:A.5.17",
    "std:SOC2:CC6.1",
    "std:PCI_DSS_4:8.3.9",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(5)(ii)(D)",
    "std:HIPAA:164.312(d)",
    "std:NIST_CSF_2:PR.AA-01",
    "cat:password_policy",
    "env:linux",
    "env:host_level",
    "risk:medium",
    "priv:required"
  ]
}

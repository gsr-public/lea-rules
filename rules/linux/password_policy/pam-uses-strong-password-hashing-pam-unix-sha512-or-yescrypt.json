{
  "name": "PAM Uses Strong Password Hashing (pam_unix sha512 or yescrypt)",
  "description": "Ensures the pam_unix password line hashes new passwords with sha512 or yescrypt.",
  "active": true,
  "category": "password_policy",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/pam.d/common-auth /etc/pam.d/common-password /etc/pam.d/common-account 2>/dev/null",
        "system": [
          "Linux"
        ],
        "distribution": [
          "Ubuntu",
          "Debian GNU/Linux"
        ]
      },
      {
        "command": "cat /etc/pam.d/system-auth /etc/pam.d/password-auth 2>/dev/null",
        "system": [
          "Linux"
        ],
        "distribution": [
          "Red Hat Enterprise Linux",
          "CentOS Linux",
          "CentOS Stream",
          "Fedora Linux",
          "Oracle Linux Server",
          "Amazon Linux",
          "Rocky Linux",
          "AlmaLinux"
        ]
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [
          "Ubuntu",
          "Debian GNU/Linux"
        ],
        "re": {
          "stdout": "(?m)^[ \\t]*password[ \\t]+[^#\\n]*\\bpam_unix\\.so\\b[^\\n]*\\b(?:sha512|yescrypt)\\b"
        },
        "not_re": {
          "stdout": "(?m)^[ \\t]*password[ \\t]+[^#\\n]*\\bpam_unix\\.so\\b[^\\n]*\\b(?:md5|bigcrypt|sha256|blowfish)\\b"
        }
      },
      {
        "system": [
          "Linux"
        ],
        "distribution": [
          "Red Hat Enterprise Linux",
          "CentOS Linux",
          "CentOS Stream",
          "Fedora Linux",
          "Oracle Linux Server",
          "Amazon Linux",
          "Rocky Linux",
          "AlmaLinux"
        ],
        "re": {
          "stdout": "(?m)^[ \\t]*password[ \\t]+[^#\\n]*\\bpam_unix\\.so\\b[^\\n]*\\b(?:sha512|yescrypt)\\b"
        },
        "not_re": {
          "stdout": "(?m)^[ \\t]*password[ \\t]+[^#\\n]*\\bpam_unix\\.so\\b[^\\n]*\\b(?:md5|bigcrypt|sha256|blowfish)\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:NIST_800-53:IA-5",
    "std:ISO27001:A.5.17",
    "std:SOC2:CC6.1",
    "std:CMMC:IA.L2-3.5.10",
    "std:PCI_DSS_4:8.3.2",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(5)(ii)(D)",
    "std:HIPAA:164.312(d)",
    "std:NIST_CSF_2:PR.AA-01",
    "cat:password_policy",
    "env:linux",
    "env:host_level",
    "risk:high"
  ]
}

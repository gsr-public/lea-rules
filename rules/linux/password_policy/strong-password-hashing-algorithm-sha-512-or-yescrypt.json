{
  "name": "Strong Password Hashing Algorithm (SHA-512 or yescrypt)",
  "description": "Ensures new passwords are hashed with SHA-512 or yescrypt (ENCRYPT_METHOD in /etc/login.defs) rather than MD5 or DES.",
  "active": true,
  "category": "password_policy",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/login.defs",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]*ENCRYPT_METHOD[ \\t]+(?:SHA512|YESCRYPT)\\b"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:NIST_800-53:IA-5",
    "std:ISO27001:A.5.17",
    "std:SOC2:CC6.1",
    "std:CMMC:IA.L2-3.5.10",
    "std:PCI_DSS_4:8.3.2",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "cat:password_policy",
    "env:linux",
    "env:host_level",
    "risk:high"
  ]
}

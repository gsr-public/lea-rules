{
  "name": "Password Complexity Enforced (pwquality)",
  "description": "Verifies that password policy requires at least one uppercase, one lowercase, one digit, and one special character.",
  "active": true,
  "category": "password_policy",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/security/pwquality.conf /etc/security/pwquality.conf.d/*.conf 2>/dev/null",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^[ \\t]*ucredit[ \\t]*=[ \\t]*-[1-9]\\b"
        }
      },
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^[ \\t]*lcredit[ \\t]*=[ \\t]*-[1-9]\\b"
        }
      },
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^[ \\t]*dcredit[ \\t]*=[ \\t]*-[1-9]\\b"
        }
      },
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^[ \\t]*ocredit[ \\t]*=[ \\t]*-[1-9]\\b"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:5.2",
    "std:NIST_800-53:IA-5",
    "std:ISO27001:A.5.17",
    "std:ISO27001:A.9.4.3",
    "std:SOC2:CC6.1",
    "std:CMMC:IA.L2-3.5.7",
    "std:PCI_DSS_4:8.3.6",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "cat:password_policy",
    "env:linux",
    "env:host_level",
    "risk:high"
  ]
}

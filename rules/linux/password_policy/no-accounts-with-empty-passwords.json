{
  "name": "No Accounts with Empty Passwords",
  "description": "Ensures no local user account has an empty password (password field blank).\nRequired sudo rule: allow user lea to run ONLY this exact command without a password: lea ALL=(root) NOPASSWD: /bin/cat /etc/shadow",
  "active": true,
  "category": "password_policy",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/shadow",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^root:"
        },
        "not_re": {
          "stdout": "(?m)^[^:\\n]+::"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:5.2",
    "std:NIST_800-53:IA-2",
    "std:NIST_800-53:IA-5",
    "std:ISO27001:A.5.17",
    "std:ISO27001:A.8.5",
    "std:ISO27001:A.9.2.4",
    "std:SOC2:CC6.1",
    "std:CMMC:IA.L2-3.5.2",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "cat:password_policy",
    "env:linux",
    "env:host_level",
    "risk:high",
    "priv:required"
  ]
}

{
  "name": "Password Expiry Warning At Least 7 Days",
  "description": "Ensures users receive sufficient advance warning before their passwords expire by configuring a password warning period.",
  "active": true,
  "category": "password_policy",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/login.defs",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^\\s*(?!#)PASS_WARN_AGE\\s+(?:[7-9]|[1-9][0-9]{1,2})\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:5.2",
    "std:NIST_800-53:IA-5",
    "std:ISO27001:A.5.17",
    "std:ISO27001:A.9.4.3",
    "std:SOC2:CC6.1",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(5)(ii)(D)",
    "std:HIPAA:164.312(d)",
    "std:NIST_CSF_2:PR.AA-01",
    "cat:password_policy",
    "env:linux",
    "env:host_level",
    "risk:low"
  ]
}

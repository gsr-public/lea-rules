{
  "name": "Audit Rules Watch Login and Logout Records",
  "description": "Ensures the audit rules record changes to the login records /var/log/lastlog and the failed-login databases (/var/run/faillock, /var/log/faillog or /var/log/tallylog).\nRequired sudo rule: allow user lea to run ONLY this exact command without a password: lea ALL=(root) NOPASSWD: /bin/cat /etc/audit/audit.rules /etc/audit/rules.d/*.rules",
  "active": true,
  "category": "audit",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/audit/audit.rules /etc/audit/rules.d/*.rules 2>/dev/null",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^[ \\t]*(?:(?:-w[ \\t]+/var/log/lastlog/?(?=[ \\t])[^\\n]*-p[ \\t]*[rwxa]*w|-a[ \\t][^\\n]*-F[ \\t]*(?:path|dir)=/var/log/lastlog/?(?=[ \\t])[^\\n]*-F[ \\t]*perm=[rwxa]*w)|(?:-w[ \\t]+/var/log/wtmp/?(?=[ \\t])[^\\n]*-p[ \\t]*[rwxa]*w|-a[ \\t][^\\n]*-F[ \\t]*(?:path|dir)=/var/log/wtmp/?(?=[ \\t])[^\\n]*-F[ \\t]*perm=[rwxa]*w))"
        }
      },
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^[ \\t]*(?:(?:-w[ \\t]+/var/run/faillock/?(?=[ \\t])[^\\n]*-p[ \\t]*[rwxa]*w|-a[ \\t][^\\n]*-F[ \\t]*(?:path|dir)=/var/run/faillock/?(?=[ \\t])[^\\n]*-F[ \\t]*perm=[rwxa]*w)|(?:-w[ \\t]+/run/faillock/?(?=[ \\t])[^\\n]*-p[ \\t]*[rwxa]*w|-a[ \\t][^\\n]*-F[ \\t]*(?:path|dir)=/run/faillock/?(?=[ \\t])[^\\n]*-F[ \\t]*perm=[rwxa]*w)|(?:-w[ \\t]+/var/log/faillog/?(?=[ \\t])[^\\n]*-p[ \\t]*[rwxa]*w|-a[ \\t][^\\n]*-F[ \\t]*(?:path|dir)=/var/log/faillog/?(?=[ \\t])[^\\n]*-F[ \\t]*perm=[rwxa]*w)|(?:-w[ \\t]+/var/log/tallylog/?(?=[ \\t])[^\\n]*-p[ \\t]*[rwxa]*w|-a[ \\t][^\\n]*-F[ \\t]*(?:path|dir)=/var/log/tallylog/?(?=[ \\t])[^\\n]*-F[ \\t]*perm=[rwxa]*w))"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:8.2",
    "std:CIS_Controls_v8:8.5",
    "std:NIST_800-53:AU-2",
    "std:NIST_800-53:AU-12",
    "std:ISO27001:A.8.15",
    "std:SOC2:CC7.2",
    "std:CMMC:AU.L2-3.3.1",
    "std:CMMC:AU.L2-3.3.2",
    "std:PCI_DSS_4:10.2.1",
    "std:PCI_DSS_4:10.2.1.4",
    "std:PCI_DSS_4:10.2.2",
    "std:NIS2:Art21.2(b)",
    "std:DORA:Art10",
    "std:HIPAA:164.312(b)",
    "std:NIST_CSF_2:PR.PS-04",
    "cat:audit",
    "env:linux",
    "env:host_level",
    "risk:medium",
    "priv:required"
  ]
}

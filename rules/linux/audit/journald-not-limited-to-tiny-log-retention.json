{
  "uid": "92c7dea1-acba-4ade-8cd6-a8f57626c363",
  "name": "Journald Not Limited to Tiny Log Retention",
  "description": "Ensures journald is not configured with a maximum retention under 30 days (MaxRetentionSec below 30d) or a SystemMaxUse below 100M, which would discard evidence before it can be reviewed.",
  "active": true,
  "category": "audit",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/systemd/journald.conf /etc/systemd/journald.conf.d/*.conf /usr/lib/systemd/journald.conf.d/*.conf 2>/dev/null",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "not_re": {
          "stdout": "(?mi)^[ \\t]*MaxRetentionSec[ \\t]*=[ \\t]*(?:\\d{1,6}s?|[12]?\\d(?:d|day)|\\d{1,3}h|\\d+min|[1-4](?:w|week))[ \\t]*$|^[ \\t]*SystemMaxUse[ \\t]*=[ \\t]*(?:\\d{1,2}M|\\d+K)\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:8.2",
    "std:CIS_Controls_v8:8.3",
    "std:NIST_800-53:AU-4",
    "std:NIST_800-53:AU-5",
    "std:NIST_800-53:AU-9",
    "std:NIST_800-53:AU-11",
    "std:ISO27001:A.8.15",
    "std:SOC2:CC7.2",
    "std:CMMC:AU.L2-3.3.1",
    "std:CMMC:AU.L2-3.3.4",
    "std:CMMC:AU.L2-3.3.8",
    "std:PCI_DSS_4:10.3.2",
    "std:PCI_DSS_4:10.5.1",
    "std:NIS2:Art21.2(b)",
    "std:DORA:Art10",
    "std:HIPAA:164.312(b)",
    "std:NIST_CSF_2:PR.PS-04",
    "cat:audit",
    "env:linux",
    "env:host_level",
    "risk:low"
  ]
}

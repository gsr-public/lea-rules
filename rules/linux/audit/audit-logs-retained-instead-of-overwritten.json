{
  "name": "Audit Logs Retained Instead of Overwritten",
  "description": "Ensures the audit daemon keeps rotated logs (max_log_file_action = keep_logs) instead of deleting or overwriting old audit records.\nRequired sudo rule: allow user lea to run ONLY this exact command without a password: lea ALL=(root) NOPASSWD: /bin/cat /etc/audit/auditd.conf",
  "active": true,
  "category": "audit",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/audit/auditd.conf",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]*max_log_file_action[ \\t]*=[ \\t]*keep_logs\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:8.2",
    "std:CIS_Controls_v8:8.10",
    "std:NIST_800-53:AU-2",
    "std:NIST_800-53:AU-5",
    "std:NIST_800-53:AU-11",
    "std:NIST_800-53:AU-12",
    "std:ISO27001:A.8.15",
    "std:ISO27001:A.12.4.1",
    "std:SOC2:CC7.2",
    "std:CMMC:AU.L2-3.3.1",
    "std:PCI_DSS_4:10.2.1",
    "std:PCI_DSS_4:10.5.1",
    "std:NIS2:Art21.2(b)",
    "std:DORA:Art10",
    "std:HIPAA:164.312(b)",
    "std:NIST_CSF_2:PR.PS-04",
    "cat:audit",
    "env:linux",
    "env:host_level",
    "risk:medium",
    "priv:required"
  ]
}

{
  "uid": "1cdf14b9-9e9f-43dc-8ac9-7b18ba062939",
  "name": "Audit Log Files Permissions 640 or Stricter",
  "description": "Ensures audit log files in /var/log/audit are owned by root (group root or adm) with mode 640 or stricter.\nRequired sudo rule: allow user lea to run ONLY this exact command without a password: lea ALL=(root) NOPASSWD: /usr/bin/stat -c %n\\ %a\\ %U\\ %G /var/log/audit/*",
  "active": true,
  "category": "audit",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "stat -c '%n %a %U %G' /var/log/audit/* 2>/dev/null",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\S"
        },
        "not_re": {
          "stdout": "(?m)^(?!LEA_RULE_no_service)\\S+ (?!(?:[46][04]0 root (?:root|adm))$)"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:3.3",
    "std:CIS_Controls_v8:8.2",
    "std:NIST_800-53:AU-9",
    "std:ISO27001:A.8.15",
    "std:SOC2:CC7.2",
    "std:CMMC:AU.L2-3.3.8",
    "std:CMMC:AU.L2-3.3.9",
    "std:PCI_DSS_4:10.3.1",
    "std:PCI_DSS_4:10.3.2",
    "std:NIS2:Art21.2(b)",
    "std:DORA:Art10",
    "std:HIPAA:164.312(b)",
    "std:NIST_CSF_2:PR.PS-04",
    "cat:audit",
    "env:linux",
    "env:host_level",
    "risk:medium",
    "priv:required"
  ]
}

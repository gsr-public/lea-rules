{
  "name": "Audit Rules Watch Docker Daemon and Configuration",
  "description": "Ensures the audit rules watch the Docker daemon binary and its configuration directory (dockerd and /etc/docker), so tampering with the container runtime is logged. Passes with LEA_RULE_no_service when dockerd is not running.\nRequired sudo rule: allow user lea to run ONLY this exact command without a password: lea ALL=(root) NOPASSWD: /bin/cat /etc/audit/audit.rules /etc/audit/rules.d/*.rules",
  "active": true,
  "category": "audit",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "if cat /proc/*/comm 2>/dev/null | grep -q '^dockerd$'; then cat /etc/audit/audit.rules /etc/audit/rules.d/*.rules 2>/dev/null; else echo 'LEA_RULE_no_service'; fi",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^[ \\t]*(?:(?:-w[ \\t]+/usr/bin/dockerd/?(?=[ \\t])[^\\n]*-p[ \\t]*[rwxa]*w|-a[ \\t][^\\n]*-F[ \\t]*(?:path|dir)=/usr/bin/dockerd/?(?=[ \\t])[^\\n]*-F[ \\t]*perm=[rwxa]*w)|(?:-w[ \\t]+/usr/bin/dockerd/?(?=[ \\t])[^\\n]*-p[ \\t]*[rwxa]*x|-a[ \\t][^\\n]*-F[ \\t]*(?:path|dir)=/usr/bin/dockerd/?(?=[ \\t])[^\\n]*-F[ \\t]*perm=[rwxa]*x))|LEA_RULE_no_service"
        }
      },
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^[ \\t]*(?:(?:-w[ \\t]+/etc/docker/?(?=[ \\t])[^\\n]*-p[ \\t]*[rwxa]*w|-a[ \\t][^\\n]*-F[ \\t]*(?:path|dir)=/etc/docker/?(?=[ \\t])[^\\n]*-F[ \\t]*perm=[rwxa]*w))|LEA_RULE_no_service"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:8.2",
    "std:CIS_Controls_v8:8.5",
    "std:NIST_800-53:AU-2",
    "std:NIST_800-53:AU-12",
    "std:NIST_800-53:CM-5",
    "std:ISO27001:A.8.15",
    "std:SOC2:CC7.2",
    "std:CMMC:AU.L2-3.3.1",
    "std:CMMC:AU.L2-3.3.2",
    "std:PCI_DSS_4:10.2.1",
    "std:PCI_DSS_4:10.2.2",
    "std:NIS2:Art21.2(b)",
    "std:DORA:Art10",
    "std:HIPAA:164.308(a)(1)(ii)(B)",
    "std:HIPAA:164.312(b)",
    "std:NIST_CSF_2:PR.PS-01",
    "std:NIST_CSF_2:PR.PS-04",
    "cat:audit",
    "env:linux",
    "env:host_level",
    "risk:medium",
    "priv:required"
  ]
}

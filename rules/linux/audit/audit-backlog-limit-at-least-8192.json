{
  "uid": "cef4a3f5-5e20-4c00-908e-1afa60af443c",
  "name": "Audit Backlog Limit At Least 8192",
  "description": "Ensures the kernel command line sets audit_backlog_limit to 8192 or more, so audit events generated during boot, before auditd starts, are not dropped from the kernel queue.",
  "active": true,
  "category": "audit",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /proc/cmdline",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?:^|\\s)audit_backlog_limit=(?:819[2-9]|8[2-9]\\d{2}|9\\d{3}|[1-9]\\d{4,})(?=\\s|$)"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],

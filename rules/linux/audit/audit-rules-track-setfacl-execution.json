{
  "uid": "0447c4d2-f25e-416c-ba1a-8602814516bb",
  "name": "Audit Rules Track setfacl Execution",
  "description": "Ensures the audit rules record every execution of /usr/bin/setfacl (-a always,exit -F path=/usr/bin/setfacl -F perm=x or -w /usr/bin/setfacl -p x), giving an independent record of privileged command use.\nRequired sudo rule: allow user lea to run ONLY this exact command without a password: lea ALL=(root) NOPASSWD: /bin/cat /etc/audit/audit.rules /etc/audit/rules.d/*.rules",
  "active": true,
  "category": "audit",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/audit/audit.rules /etc/audit/rules.d/*.rules 2>/dev/null",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^[ \\t]*(?:-a[ \\t]+(?:always,exit|exit,always)[^\\n]*-F[ \\t]*path=/usr/bin/setfacl(?=[ \\t])[^\\n]*-F[ \\t]*perm=[rwa]*x|-w[ \\t]+/usr/bin/setfacl(?=[ \\t])[^\\n]*-p[ \\t]*[rwa]*x)"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:8.2",
    "std:CIS_Controls_v8:8.5",
    "std:NIST_800-53:AC-6",
    "std:NIST_800-53:AU-2",
    "std:NIST_800-53:AU-12",
    "std:ISO27001:A.8.15",
    "std:SOC2:CC7.2",

{
  "name": "Audit Records Forwarded to a Remote Server (audisp-remote)",
  "description": "Ensures the audisp-remote plugin is active (active = yes in /etc/audit/plugins.d/au-remote.conf or /etc/audisp/plugins.d/au-remote.conf), so audit records leave the host before an attacker with root can delete them.\nRequired sudo rule: allow user lea to run ONLY this exact command without a password: lea ALL=(root) NOPASSWD: /bin/cat /etc/audit/plugins.d/au-remote.conf /etc/audisp/plugins.d/au-remote.conf",
  "active": true,
  "category": "audit",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/audit/plugins.d/au-remote.conf /etc/audisp/plugins.d/au-remote.conf 2>/dev/null",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^[ \\t]*active[ \\t]*=[ \\t]*yes\\b"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:8.2",
    "std:CIS_Controls_v8:8.9",
    "std:NIST_800-53:AU-4",
    "std:NIST_800-53:AU-6",
    "std:NIST_800-53:AU-9",
    "std:ISO27001:A.8.15",
    "std:SOC2:CC7.2",
    "std:CMMC:AU.L2-3.3.1",
    "std:CMMC:AU.L2-3.3.5",
    "std:PCI_DSS_4:10.3.3",
    "std:NIS2:Art21.2(b)",
    "std:DORA:Art10",
    "std:HIPAA:164.308(a)(1)(ii)(D)",
    "std:HIPAA:164.312(b)",
    "std:NIST_CSF_2:DE.AE-02",
    "std:NIST_CSF_2:PR.PS-04",
    "cat:audit",
    "env:linux",
    "env:host_level",
    "risk:medium",
    "priv:required"
  ]
}

{
  "name": "Sudo Activity Logged to a Dedicated File",
  "description": "Ensures sudoers sets 'Defaults logfile=/path', giving an independent record of every command run with elevated privileges.\nRequired sudo rule: allow user lea to run ONLY this exact command without a password: lea ALL=(root) NOPASSWD: /bin/cat /etc/sudoers /etc/sudoers.d/*",
  "active": true,
  "category": "audit",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/sudoers /etc/sudoers.d/* 2>/dev/null",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]*Defaults\\b[^\\n]*\\blogfile[ \\t]*=[ \\t]*\"?/"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:8.2",
    "std:CIS_Controls_v8:8.8",
    "std:NIST_800-53:AU-2",
    "std:NIST_800-53:AU-12",
    "std:ISO27001:A.8.15",
    "std:SOC2:CC7.2",
    "std:CMMC:AC.L2-3.1.7",
    "std:CMMC:AU.L2-3.3.1",
    "std:PCI_DSS_4:10.2.1",
    "std:NIS2:Art21.2(b)",
    "std:DORA:Art10",
    "cat:audit",
    "env:linux",
    "env:host_level",
    "risk:medium",
    "priv:required"
  ]
}

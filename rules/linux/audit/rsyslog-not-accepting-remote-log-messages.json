{
  "uid": "1fd8f1f5-1264-470f-9eae-fc4d76e13650",
  "name": "rsyslog Not Accepting Remote Log Messages",
  "description": "Ensures rsyslog does not load the TCP or UDP network input modules (imtcp, imudp, imrelp) on hosts that are not designated log collectors, so attackers cannot flood or forge local logs over the network. Passes with LEA_RULE_no_service when rsyslogd is not running.",
  "active": true,
  "category": "audit",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "if cat /proc/*/comm 2>/dev/null | grep -q '^rsyslogd$'; then cat /etc/rsyslog.conf /etc/rsyslog.d/*.conf 2>/dev/null; else echo 'LEA_RULE_no_service'; fi",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\S"
        },
        "not_re": {
          "stdout": "(?mi)^[ \\t]*(?:\\$ModLoad[ \\t]+im(?:tcp|udp|relp)\\b|\\$(?:InputTCPServerRun|UDPServerRun)\\b|module\\([^)\\n]*load[ \\t]*=[ \\t]*\"im(?:tcp|udp|relp)\"|input\\([^)\\n]*type[ \\t]*=[ \\t]*\"im(?:tcp|udp|relp)\")"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.4",
    "std:CIS_Controls_v8:4.8",
    "std:NIST_800-53:CM-7",
    "std:NIST_800-53:SC-7",
    "std:ISO27001:A.8.9",
    "std:ISO27001:A.8.20",
    "std:SOC2:CC6.6",
    "std:CMMC:CM.L2-3.4.7",
    "std:CMMC:SC.L2-3.13.1",
    "std:PCI_DSS_4:1.3.1",
    "std:PCI_DSS_4:2.2.4",
    "std:NIS2:Art21.2(e)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(1)(ii)(B)",
    "std:HIPAA:164.312(e)(1)",
    "std:NIST_CSF_2:PR.IR-01",
    "std:NIST_CSF_2:PR.PS-01",
    "cat:audit",
    "env:linux",
    "env:host_level",
    "risk:low"
  ]
}

{
  "name": "Audit Tools Protected from Modification",
  "description": "Ensures the audit tools (auditctl, aureport, ausearch, autrace, auditd, augenrules) are owned by root:root and not writable by group or others, so they cannot be replaced to hide activity. stat reads metadata only.",
  "active": true,
  "category": "audit",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "stat -c '%n %a %U %G' /sbin/auditctl /sbin/aureport /sbin/ausearch /sbin/autrace /sbin/auditd /sbin/augenrules 2>/dev/null",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\S"
        },
        "not_re": {
          "stdout": "(?m)^(?!LEA_RULE_no_service)\\S+ (?!(?:[0-7][0-5][0-5] root root)$)"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:3.3",
    "std:CIS_Controls_v8:8.2",
    "std:NIST_800-53:AU-9",
    "std:ISO27001:A.8.15",
    "std:SOC2:CC7.2",
    "std:CMMC:AU.L2-3.3.8",
    "std:CMMC:AU.L2-3.3.9",
    "std:PCI_DSS_4:10.3.1",
    "std:PCI_DSS_4:10.3.2",
    "std:NIS2:Art21.2(b)",
    "std:DORA:Art10",
    "std:HIPAA:164.312(b)",
    "std:NIST_CSF_2:PR.PS-04",
    "cat:audit",
    "env:linux",
    "env:host_level",
    "risk:medium"
  ]
}

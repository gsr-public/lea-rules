{
  "name": "Auditing Enabled for Processes Started Before auditd",
  "description": "Ensures the kernel command line contains audit=1, so processes that start before the audit daemon are also auditable.",
  "active": true,
  "category": "audit",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /proc/cmdline",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\baudit=1\\b"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],

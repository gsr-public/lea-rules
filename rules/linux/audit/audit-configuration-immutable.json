{
  "name": "Audit Configuration Immutable",
  "description": "Ensures the audit rules end with '-e 2', which locks the audit configuration until reboot so an attacker with root cannot silently disable auditing.\nRequired sudo rule: allow user lea to run ONLY this exact command without a password: lea ALL=(root) NOPASSWD: /bin/cat /etc/audit/audit.rules /etc/audit/rules.d/*.rules",
  "active": true,
  "category": "audit",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/audit/audit.rules /etc/audit/rules.d/*.rules 2>/dev/null",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^[ \\t]*-e[ \\t]+2\\b"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:8.2",
    "std:NIST_800-53:AU-2",
    "std:NIST_800-53:AU-9",
    "std:NIST_800-53:AU-12",
    "std:ISO27001:A.8.15",
    "std:SOC2:CC7.2",
    "std:CMMC:AU.L2-3.3.1",
    "std:CMMC:AU.L2-3.3.8",
    "std:PCI_DSS_4:10.2.1",
    "std:PCI_DSS_4:10.3.2",
    "std:NIS2:Art21.2(b)",
    "std:DORA:Art10",
    "cat:audit",
    "env:linux",
    "env:host_level",
    "risk:medium",
    "priv:required"
  ]
}

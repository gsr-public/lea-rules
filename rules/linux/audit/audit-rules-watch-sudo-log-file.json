{
  "uid": "c4a10bb7-c8dd-4711-83cd-c3897b5404fb",
  "name": "Audit Rules Watch Sudo Log File",
  "description": "Ensures the audit rules record changes to the sudo log file (/var/log/sudo.log or similar), so attempts to erase sudo activity are logged.\nRequired sudo rule: allow user lea to run ONLY this exact command without a password: lea ALL=(root) NOPASSWD: /bin/cat /etc/audit/audit.rules /etc/audit/rules.d/*.rules",
  "active": true,
  "category": "audit",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/audit/audit.rules /etc/audit/rules.d/*.rules 2>/dev/null",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^[ \\t]*(?:-w[ \\t]+/var/log/sudo[^ \\t\\n]*[ \\t][^\\n]*-p[ \\t]*[rwxa]*w)"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:3.3",
    "std:CIS_Controls_v8:8.2",
    "std:NIST_800-53:AU-9",

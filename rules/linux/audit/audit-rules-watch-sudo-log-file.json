    "std:SOC2:CC7.2",
    "std:CMMC:AU.L2-3.3.8",
    "std:CMMC:AU.L2-3.3.9",
    "std:PCI_DSS_4:10.2.1.3",
    "std:PCI_DSS_4:10.3.1",
    "std:PCI_DSS_4:10.3.2",
    "std:NIS2:Art21.2(b)",
    "std:DORA:Art10",
    "std:HIPAA:164.312(b)",
    "std:NIST_CSF_2:PR.PS-04",
    "cat:audit",
    "env:linux",
    "env:host_level",
    "risk:medium",
    "priv:required"
  ]
}

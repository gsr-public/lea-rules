{
  "uid": "9841421c-02f1-4b23-8cc2-50dee65509c3",
  "name": "Audit Rules Track Commands Run as Another User",
  "description": "Ensures the audit rules record every execve where the effective UID differs from the real UID (-C euid!=uid), capturing actions performed through sudo, su and set-UID programs.\nRequired sudo rule: allow user lea to run ONLY this exact command without a password: lea ALL=(root) NOPASSWD: /bin/cat /etc/audit/audit.rules /etc/audit/rules.d/*.rules",
  "active": true,
  "category": "audit",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/audit/audit.rules /etc/audit/rules.d/*.rules 2>/dev/null",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^[ \\t]*(?:-a[ \\t]+(?:always,exit|exit,always)[^\\n]*-C[ \\t]*(?:euid!=uid|uid!=euid)[^\\n]*-S[ \\t]*execve\\b|-a[ \\t]+(?:always,exit|exit,always)[^\\n]*-S[ \\t]*execve\\b[^\\n]*-C[ \\t]*(?:euid!=uid|uid!=euid))"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:8.2",
    "std:CIS_Controls_v8:8.5",
    "std:CIS_Controls_v8:8.8",
    "std:NIST_800-53:AC-6",
    "std:NIST_800-53:AU-2",
    "std:NIST_800-53:AU-12",

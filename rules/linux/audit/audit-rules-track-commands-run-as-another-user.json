    "std:CMMC:AC.L2-3.1.7",
    "std:CMMC:AU.L2-3.3.1",
    "std:CMMC:AU.L2-3.3.2",
    "std:PCI_DSS_4:10.2.1",
    "std:PCI_DSS_4:10.2.1.2",
    "std:PCI_DSS_4:10.2.2",
    "std:NIS2:Art21.2(b)",
    "std:DORA:Art10",
    "std:HIPAA:164.312(a)(1)",
    "std:HIPAA:164.312(b)",
    "std:NIST_CSF_2:PR.AA-05",
    "std:NIST_CSF_2:PR.PS-04",

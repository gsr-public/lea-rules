{
  "uid": "e89679c8-26e1-420a-ac43-bf18a364b699",
  "name": "Audit Rules Watch Login Configuration",
  "description": "Ensures the audit rules record changes to /etc/login.defs and /etc/securetty or /etc/default/useradd, which control password aging and account defaults.\nRequired sudo rule: allow user lea to run ONLY this exact command without a password: lea ALL=(root) NOPASSWD: /bin/cat /etc/audit/audit.rules /etc/audit/rules.d/*.rules",
  "active": true,
  "category": "audit",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/audit/audit.rules /etc/audit/rules.d/*.rules 2>/dev/null",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^[ \\t]*(?:(?:-w[ \\t]+/etc/login\\.defs/?(?=[ \\t])[^\\n]*-p[ \\t]*[rwxa]*w|-a[ \\t][^\\n]*-F[ \\t]*(?:path|dir)=/etc/login\\.defs/?(?=[ \\t])[^\\n]*-F[ \\t]*perm=[rwxa]*w))"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:8.2",
    "std:CIS_Controls_v8:8.5",
    "std:NIST_800-53:AU-2",
    "std:NIST_800-53:AU-12",
    "std:NIST_800-53:CM-5",
    "std:ISO27001:A.8.15",
    "std:SOC2:CC7.2",
    "std:CMMC:AU.L2-3.3.1",
    "std:CMMC:AU.L2-3.3.2",
    "std:PCI_DSS_4:10.2.1",
    "std:PCI_DSS_4:10.2.2",
    "std:NIS2:Art21.2(b)",
    "std:DORA:Art10",
    "std:HIPAA:164.308(a)(1)(ii)(B)",
    "std:HIPAA:164.312(b)",
    "std:NIST_CSF_2:PR.PS-01",
    "std:NIST_CSF_2:PR.PS-04",
    "cat:audit",
    "env:linux",
    "env:host_level",
    "risk:medium",
    "priv:required"
  ]
}

{
  "name": "rsyslog Log File Creation Mode 0640 or Stricter",
  "description": "Ensures rsyslog creates log files with mode 0640 or stricter ($FileCreateMode or fileCreateMode), so new log files are not world-readable. Passes with LEA_RULE_no_service when rsyslogd is not running.",
  "active": true,
  "category": "audit",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "if cat /proc/*/comm 2>/dev/null | grep -q '^rsyslogd$'; then cat /etc/rsyslog.conf /etc/rsyslog.d/*.conf 2>/dev/null; else echo 'LEA_RULE_no_service'; fi",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)(?:^[ \\t]*\\$FileCreateMode[ \\t]+|\\bfileCreateMode[ \\t]*=[ \\t]*\")0?[0-6][0-4]0\\b|LEA_RULE_no_service"
        },
        "not_re": {
          "stdout": "(?mi)(?:^[ \\t]*\\$FileCreateMode[ \\t]+|\\bfileCreateMode[ \\t]*=[ \\t]*\")0?[0-7](?:[0-7][1-7]|[2367][0-7])\\b"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:3.3",
    "std:CIS_Controls_v8:8.2",
    "std:NIST_800-53:AU-9",
    "std:ISO27001:A.8.15",
    "std:SOC2:CC7.2",
    "std:CMMC:AU.L2-3.3.8",
    "std:CMMC:AU.L2-3.3.9",
    "std:PCI_DSS_4:10.3.1",
    "std:PCI_DSS_4:10.3.2",
    "std:NIS2:Art21.2(b)",
    "std:DORA:Art10",
    "std:HIPAA:164.312(b)",
    "std:NIST_CSF_2:PR.PS-04",
    "cat:audit",
    "env:linux",
    "env:host_level",
    "risk:medium"
  ]
}

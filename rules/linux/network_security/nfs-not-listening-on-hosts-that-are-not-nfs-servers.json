{
  "uid": "8db6e5df-ae04-43fd-aa49-867128a68527",
  "name": "NFS Not Listening on Hosts That Are Not NFS Servers",
  "description": "Ensures nothing listens for NFS on TCP port 2049; assign only to hosts that are not NFS servers. Reads the raw kernel socket tables /proc/net/tcp and /proc/net/tcp6 (state 0A = LISTEN).",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /proc/net/tcp /proc/net/tcp6",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\bsl\\b"
        },
        "not_re": {
          "stdout": "(?m)^\\s*\\d+:\\s+[0-9A-F]{8}(?:[0-9A-F]{24})?:(?:0801)\\s+[0-9A-F]+:[0-9A-F]{4}\\s+0A\\b"
        }
      }
    ],

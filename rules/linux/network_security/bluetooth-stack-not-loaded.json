{
  "name": "Bluetooth Stack Not Loaded",
  "description": "Ensures the Bluetooth protocol stack (servers and hosts without Bluetooth peripherals) is not loaded (checked in the first column of /proc/modules). A driver compiled into the kernel is not detected.",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /proc/modules",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\S"
        },
        "not_re": {
          "stdout": "(?m)^bluetooth[ \\t]"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.8",
    "std:NIST_800-53:AC-18",
    "std:NIST_800-53:CM-7",
    "std:ISO27001:A.8.20",
    "std:SOC2:CC6.6",
    "std:CMMC:AC.L2-3.1.16",
    "std:CMMC:CM.L2-3.4.7",
    "std:PCI_DSS_4:2.2.4",
    "std:NIS2:Art21.2(e)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(1)(ii)(B)",
    "std:HIPAA:164.312(e)(1)",
    "std:NIST_CSF_2:PR.IR-01",
    "std:NIST_CSF_2:PR.PS-01",
    "cat:network_security",
    "env:linux",
    "env:host_level",
    "risk:low"
  ]
}

  "name": "No Active Wireless Interfaces on Servers",
  "description": "Ensures no wireless network interface is present (/proc/net/wireless lists none), so servers cannot be bridged to unmanaged wireless networks. Assign only to servers.",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /proc/net/wireless 2>/dev/null",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],

{
  "uid": "4080f5b4-6e0f-4fe9-8a9f-16615979dbf3",
  "name": "Linux IPv6 Router Advertisement Default Route Not Accepted",
  "description": "Ensures net.ipv6.conf.all.accept_ra_defrtr is 0, so a rogue IPv6 router advertisement cannot install a default route that redirects traffic. Passes with LEA_RULE_no_service when IPv6 is disabled. Hosts that rely on SLAAC should be excluded.",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /proc/sys/net/ipv6/conf/all/accept_ra_defrtr 2>/dev/null || echo 'LEA_RULE_no_service'",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\A(?:0)\\s*\\Z|LEA_RULE_no_service"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.1",
    "std:NIST_800-53:SC-7",
    "std:ISO27001:A.8.20",
    "std:SOC2:CC6.6",
    "std:CMMC:SC.L2-3.13.1",
    "std:PCI_DSS_4:2.2.6",
    "std:NIS2:Art21.2(e)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(1)(ii)(B)",
    "std:HIPAA:164.312(e)(1)",
    "std:NIST_CSF_2:PR.IR-01",
    "cat:network_security",
    "env:linux",
    "env:host_level",
    "risk:low"
  ]
}

{
  "name": "Linux TCP Keepalive Time Bounded (300-900 Seconds)",
  "description": "Ensures the Linux kernel parameter net.ipv4.tcp_keepalive_time is configured within an optimal range (300–900 seconds) to detect dead peers without excessive network chatter.\nRequired sudo rule (remedy only): allow user lea to run ONLY this exact command without a password: lea ALL=(root) NOPASSWD: /sbin/sysctl -w net.ipv4.tcp_keepalive_time=600",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /proc/sys/net/ipv4/tcp_keepalive_time",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "^(?:[3-8][0-9]{2}|900)$"
        }
      }
    ],
    "remedy": [
      {
        "command": "sysctl -w net.ipv4.tcp_keepalive_time=600 >/dev/null && cat /proc/sys/net/ipv4/tcp_keepalive_time",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.1",
    "std:NIST_800-53:SC-5",
    "std:NIST_800-53:SC-7",
    "std:ISO27001:A.8.20",
    "std:SOC2:CC6.6",
    "std:CMMC:SC.L2-3.13.1",
    "std:PCI_DSS_4:2.2.6",
    "std:NIS2:Art21.2(e)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(1)(ii)(B)",
    "std:HIPAA:164.312(e)(1)",
    "std:NIST_CSF_2:PR.IR-01",
    "std:NIST_CSF_2:PR.IR-04",
    "cat:network_security",
    "env:linux",
    "env:host_level",
    "risk:low"
  ]
}

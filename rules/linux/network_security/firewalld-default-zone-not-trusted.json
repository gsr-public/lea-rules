{
  "name": "firewalld Default Zone Not trusted",
  "description": "Ensures the firewalld default zone is not \"trusted\", which accepts all traffic.",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/firewalld/firewalld.conf",
        "system": [
          "Linux"
        ],
        "distribution": [
          "Red Hat Enterprise Linux",
          "CentOS Linux",
          "CentOS Stream",
          "Fedora Linux",
          "Oracle Linux Server",
          "Amazon Linux",
          "Rocky Linux",
          "AlmaLinux"
        ]
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [
          "Red Hat Enterprise Linux",
          "CentOS Linux",
          "CentOS Stream",
          "Fedora Linux",
          "Oracle Linux Server",
          "Amazon Linux",
          "Rocky Linux",
          "AlmaLinux"
        ],
        "re": {
          "stdout": "(?m)^[ \\t]*DefaultZone[ \\t]*=[ \\t]*\\S"
        },
        "not_re": {
          "stdout": "(?m)^[ \\t]*DefaultZone[ \\t]*=[ \\t]*trusted\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.4",
    "std:CIS_Controls_v8:4.5",
    "std:NIST_800-53:AC-4",
    "std:NIST_800-53:SC-7",
    "std:ISO27001:A.8.20",
    "std:SOC2:CC6.6",
    "std:CMMC:SC.L2-3.13.1",
    "std:CMMC:SC.L2-3.13.6",
    "std:PCI_DSS_4:1.3.1",
    "std:PCI_DSS_4:1.5.1",
    "std:NIS2:Art21.2(e)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(1)(ii)(B)",
    "std:HIPAA:164.312(e)(1)",
    "std:NIST_CSF_2:PR.IR-01",
    "cat:network_security",
    "env:linux",
    "env:host_level",
    "risk:high"
  ]
}

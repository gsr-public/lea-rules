{
  "name": "Linux Source-Routed Packets Rejected (All Interfaces)",
  "description": "Ensures IPv4 and IPv6 source-routed packets are not accepted on any interface (net.ipv4.conf.all.accept_source_route = 0 and net.ipv6.conf.all.accept_source_route = 0). Every value printed must be 0; hosts without IPv6 report only the IPv4 value.",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /proc/sys/net/ipv4/conf/all/accept_source_route /proc/sys/net/ipv6/conf/all/accept_source_route",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\A(?:0\\s*)+\\Z"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.1",
    "std:NIST_800-53:SC-7",
    "std:ISO27001:A.8.20",
    "std:SOC2:CC6.6",
    "std:CMMC:SC.L2-3.13.1",
    "std:PCI_DSS_4:1.4.3",
    "std:PCI_DSS_4:2.2.6",
    "std:NIS2:Art21.2(e)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(1)(ii)(B)",
    "std:HIPAA:164.312(e)(1)",
    "std:NIST_CSF_2:PR.IR-01",
    "cat:network_security",
    "env:linux",
    "env:host_level",
    "risk:medium"
  ]
}

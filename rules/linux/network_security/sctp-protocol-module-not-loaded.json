{
  "uid": "ea87fe14-2ef7-42bc-95d8-97ca4b741084",
  "name": "SCTP Protocol Module Not Loaded",
  "description": "Ensures the SCTP network protocol module is not loaded (checked in /proc/modules). Rarely used protocol modules have a history of kernel vulnerabilities. A driver compiled into the kernel is not detected. Telecom and some clustering software use SCTP; exclude those hosts.\nRequired sudo rule (remedy only): allow user lea to run ONLY this exact command without a password: lea ALL=(root) NOPASSWD: /sbin/modprobe -r sctp",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /proc/modules",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\S"
        },
        "not_re": {
          "stdout": "(?m)^sctp[ \\t]"
        }
      }
    ],
    "_remedy": [
      {
        "command": "modprobe -r sctp 2>/dev/null; cat /proc/modules",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.8",
    "std:NIST_800-53:CM-7",
    "std:ISO27001:A.8.9",
    "std:SOC2:CC6.6",
    "std:CMMC:CM.L2-3.4.6",
    "std:CMMC:CM.L2-3.4.7",
    "std:PCI_DSS_4:2.2.4",
    "std:NIS2:Art21.2(e)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(1)(ii)(B)",
    "std:NIST_CSF_2:PR.PS-01",
    "cat:network_security",
    "env:linux",
    "env:host_level",
    "risk:low"
  ]
}

{
  "uid": "54045135-3fe7-4468-943e-d6d4008ff714",
  "name": "Linux Reverse Path Filter Default Interfaces",
  "description": "Ensures net.ipv4.conf.default.rp_filter is 1 (strict) or 2 (loose) so new interfaces inherit reverse path filtering. The remedy applies loose mode, which is safe for multi-homed hosts with asymmetric routing.\nRequired sudo rule (remedy only): allow user lea to run ONLY this exact command without a password: lea ALL=(root) NOPASSWD: /sbin/sysctl -w net.ipv4.conf.default.rp_filter=2",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /proc/sys/net/ipv4/conf/default/rp_filter",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "^(?:1|2)$"
        }
      }
    ],
    "_remedy": [
      {
        "command": "sysctl -w net.ipv4.conf.default.rp_filter=2 >/dev/null && cat /proc/sys/net/ipv4/conf/default/rp_filter",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.1",

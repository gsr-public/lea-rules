{
  "name": "Linux IPv6 Firewall Default Deny Policy (ip6tables)",
  "description": "Ensures the ip6tables INPUT and FORWARD chains default to DROP or REJECT, so IPv6 does not bypass an IPv4-only firewall. Passes when IPv6 is disabled in the kernel.\nRequired sudo rule: allow user lea to run ONLY this exact command without a password: lea ALL=(root) NOPASSWD: /usr/sbin/ip6tables -L -n",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "if [ -e /proc/net/if_inet6 ]; then ip6tables -L -n; else echo 'LEA_RULE_no_service'; fi",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^Chain INPUT \\(policy (?:DROP|REJECT)\\)|LEA_RULE_no_service"
        }
      },
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^Chain FORWARD \\(policy (?:DROP|REJECT)\\)|LEA_RULE_no_service"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.4",
    "std:CIS_Controls_v8:4.5",
    "std:NIST_800-53:AC-4",
    "std:NIST_800-53:SC-7",
    "std:ISO27001:A.8.20",
    "std:SOC2:CC6.6",
    "std:CMMC:SC.L2-3.13.1",
    "std:CMMC:SC.L2-3.13.6",
    "std:PCI_DSS_4:1.3.1",
    "std:PCI_DSS_4:1.5.1",
    "std:NIS2:Art21.2(e)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(1)(ii)(B)",
    "std:HIPAA:164.312(e)(1)",
    "std:NIST_CSF_2:PR.IR-01",
    "cat:network_security",
    "env:linux",
    "env:host_level",
    "risk:high",
    "priv:required"
  ]
}

{
  "name": "systemd-resolved LLMNR and mDNS Disabled",
  "description": "Ensures systemd-resolved does not answer or send LLMNR and multicast DNS (LLMNR=no and MulticastDNS=no), which are easily spoofed to capture credentials. Passes with LEA_RULE_no_service when systemd-resolved is not running.",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "if cat /proc/*/comm 2>/dev/null | grep -q '^systemd-resolve$'; then cat /etc/systemd/resolved.conf /etc/systemd/resolved.conf.d/*.conf 2>/dev/null; echo LEA_RESOLVED; else echo 'LEA_RULE_no_service'; fi",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]*LLMNR[ \\t]*=[ \\t]*(?:no|false|0)\\b|LEA_RULE_no_service"
        },
        "not_re": {
          "stdout": "(?mi)^[ \\t]*MulticastDNS[ \\t]*=[ \\t]*(?:yes|true|1|resolve)\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.4",
    "std:CIS_Controls_v8:4.8",
    "std:NIST_800-53:CM-7",
    "std:NIST_800-53:SC-7",
    "std:NIST_800-53:SC-20",
    "std:ISO27001:A.8.9",
    "std:ISO27001:A.8.20",
    "std:SOC2:CC6.6",
    "std:CMMC:CM.L2-3.4.7",
    "std:CMMC:SC.L2-3.13.1",
    "std:PCI_DSS_4:1.3.1",
    "std:PCI_DSS_4:2.2.4",
    "std:NIS2:Art21.2(e)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(1)(ii)(B)",
    "std:HIPAA:164.312(e)(1)",
    "std:NIST_CSF_2:PR.IR-01",
    "std:NIST_CSF_2:PR.PS-01",
    "cat:network_security",
    "env:linux",
    "env:host_level",
    "risk:medium"
  ]
}

{
  "name": "Java TLS Legacy Protocols and Weak Algorithms Disabled",
  "description": "Ensures every installed OpenJDK runtime disables SSLv3, TLSv1, TLSv1.1, RC4, 3DES and MD5 for TLS (jdk.tls.disabledAlgorithms). Continuation lines in java.security are evaluated. Passes with LEA_RULE_no_service when no OpenJDK java.security file is present.",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "found=0; for f in /etc/java-*/security/java.security /usr/lib/jvm/*/conf/security/java.security /usr/lib/jvm/*/jre/lib/security/java.security; do [ -f \"$f\" ] && { cat \"$f\"; found=1; }; done; [ \"$found\" = 1 ] || echo 'LEA_RULE_no_service'",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^[ \\t]*jdk\\.tls\\.disabledAlgorithms[ \\t]*=(?:[^\\\\\\n]|\\\\\\r?\\n)*?\\bSSLv3\\b|LEA_RULE_no_service"
        }
      },
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^[ \\t]*jdk\\.tls\\.disabledAlgorithms[ \\t]*=(?:[^\\\\\\n]|\\\\\\r?\\n)*?\\bTLSv1\\b(?!\\.)|LEA_RULE_no_service"
        }
      },
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^[ \\t]*jdk\\.tls\\.disabledAlgorithms[ \\t]*=(?:[^\\\\\\n]|\\\\\\r?\\n)*?\\bTLSv1\\.1\\b|LEA_RULE_no_service"
        }
      },
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^[ \\t]*jdk\\.tls\\.disabledAlgorithms[ \\t]*=(?:[^\\\\\\n]|\\\\\\r?\\n)*?\\bRC4\\b|LEA_RULE_no_service"
        }
      },
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^[ \\t]*jdk\\.tls\\.disabledAlgorithms[ \\t]*=(?:[^\\\\\\n]|\\\\\\r?\\n)*?\\b3DES|LEA_RULE_no_service"
        }
      },
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^[ \\t]*jdk\\.tls\\.disabledAlgorithms[ \\t]*=(?:[^\\\\\\n]|\\\\\\r?\\n)*?\\bMD5|LEA_RULE_no_service"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:3.10",
    "std:NIST_800-53:SC-8",
    "std:NIST_800-53:SC-12",
    "std:NIST_800-53:SC-13",
    "std:ISO27001:A.8.24",
    "std:SOC2:CC6.7",
    "std:CMMC:SC.L2-3.13.8",
    "std:CMMC:SC.L2-3.13.11",
    "std:PCI_DSS_4:4.2.1",
    "std:NIS2:Art21.2(h)",
    "std:DORA:Art9",
    "std:NIST_PQC:transition",
    "cat:network_security",
    "env:linux",
    "env:host_level",
    "risk:high"
  ]
}

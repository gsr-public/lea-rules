{
  "name": "Mail Transfer Agent Listens Only on Loopback",
  "description": "Ensures nothing listens on TCP port 25 (SMTP) on a non-loopback address, by reading the raw kernel socket tables /proc/net/tcp and /proc/net/tcp6 (port 0x0019 in state 0A = LISTEN; 0100007F is 127.0.0.1). Hosts that are not mail servers should only accept local mail submission.",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /proc/net/tcp /proc/net/tcp6",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\bsl\\b"
        },
        "not_re": {
          "stdout": "(?m)^\\s*\\d+:\\s+(?!0100007F:|0{24}01000000:)[0-9A-F]{8}(?:[0-9A-F]{24})?:0019\\s+[0-9A-F]+:0000\\s+0A\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.8",
    "std:NIST_800-53:CM-7",
    "std:ISO27001:A.8.9",
    "std:SOC2:CC6.6",
    "std:CMMC:CM.L2-3.4.6",
    "std:CMMC:CM.L2-3.4.7",
    "std:PCI_DSS_4:2.2.4",
    "std:NIS2:Art21.2(e)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(1)(ii)(B)",
    "std:NIST_CSF_2:PR.PS-01",
    "cat:network_security",
    "env:linux",
    "env:host_level",
    "risk:medium"
  ]
}

{
  "name": "rsync Daemon Not Listening",
  "description": "Ensures nothing listens for the rsync daemon on TCP port 873, which transfers data in clear text. Reads the raw kernel socket tables /proc/net/tcp and /proc/net/tcp6 (state 0A = LISTEN).",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /proc/net/tcp /proc/net/tcp6",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\bsl\\b"
        },
        "not_re": {
          "stdout": "(?m)^\\s*\\d+:\\s+[0-9A-F]{8}(?:[0-9A-F]{24})?:(?:0369)\\s+[0-9A-F]+:[0-9A-F]{4}\\s+0A\\b"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],

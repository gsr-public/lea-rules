{
  "uid": "facb1058-c522-4215-934e-f4185332e80f",
  "name": "Local Package Signature Verification Enforced (localpkg_gpgcheck)",
  "description": "Ensures dnf/yum verify the signatures of local package files as well (localpkg_gpgcheck=1), so unsigned RPMs copied to the host cannot be installed silently.",
  "active": true,
  "category": "integrity",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/dnf/dnf.conf /etc/yum.conf 2>/dev/null",
        "system": [
          "Linux"
        ],
        "distribution": [
          "Red Hat Enterprise Linux",
          "CentOS Linux",
          "CentOS Stream",
          "Fedora Linux",
          "Oracle Linux Server",
          "Amazon Linux",
          "Rocky Linux",
          "AlmaLinux"
        ]
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [
          "Red Hat Enterprise Linux",
          "CentOS Linux",
          "CentOS Stream",
          "Fedora Linux",
          "Oracle Linux Server",
          "Amazon Linux",
          "Rocky Linux",
          "AlmaLinux"
        ],
        "re": {
          "stdout": "(?mi)^[ \\t]*localpkg_gpgcheck[ \\t]*=[ \\t]*(?:1|true|yes)\\b"
        },
        "not_re": {
          "stdout": "(?mi)^[ \\t]*localpkg_gpgcheck[ \\t]*=[ \\t]*(?:0|false|no)\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:2.5",
    "std:NIST_800-53:CM-7",
    "std:NIST_800-53:CM-14",
    "std:NIST_800-53:SI-7",
    "std:ISO27001:A.8.19",
    "std:SOC2:CC6.8",

{
  "uid": "0a601296-8070-4026-84db-5f0086dc8cca",
  "name": "Sudo Requires Password for Privilege Escalation (No NOPASSWD)",
  "description": "Ensures no sudoers entry grants password-less privilege escalation (NOPASSWD), except entries for the LEA agent account (lea), whose delegated read-only commands need it.\nRequired sudo rule: allow user lea to run ONLY this exact command without a password: lea ALL=(root) NOPASSWD: /bin/cat /etc/sudoers /etc/sudoers.d/*",
  "active": true,
  "category": "access_control",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/sudoers /etc/sudoers.d/* 2>/dev/null",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\S"
        },
        "not_re": {
          "stdout": "(?m)^[ \\t]*(?!#|lea[ \\t])[^\\n]*\\bNOPASSWD[ \\t]*:"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:5.4",
    "std:NIST_800-53:AC-6",
    "std:NIST_800-53:IA-11",
    "std:ISO27001:A.8.2",
    "std:SOC2:CC6.3",
    "std:CMMC:AC.L2-3.1.5",
    "std:CMMC:AC.L2-3.1.7",
    "std:PCI_DSS_4:7.2.2",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.312(a)(1)",
    "std:NIST_CSF_2:PR.AA-05",
    "cat:access_control",
    "env:linux",
    "env:host_level",
    "risk:high",
    "priv:required"
  ]
}

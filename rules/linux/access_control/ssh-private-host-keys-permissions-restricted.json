{
  "name": "SSH Private Host Keys Permissions Restricted",
  "description": "Ensures every SSH private host key (/etc/ssh/ssh_host_*_key) is owned by root and readable only by root (600/400) or, on RHEL-family systems, by the ssh_keys group (640). A stolen host key lets an attacker impersonate the server. Passes with LEA_RULE_no_service when no host keys exist.",
  "active": true,
  "category": "access_control",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "stat -c '%n %a %U %G' /etc/ssh/ssh_host_*_key 2>/dev/null || echo 'LEA_RULE_no_service'",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\S"
        },
        "not_re": {
          "stdout": "(?m)^(?!LEA_RULE_no_service)\\S+ (?!(?:[46]00 root root|[46][04]0 root ssh_keys)$)"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:3.3",
    "std:NIST_800-53:AC-3",
    "std:NIST_800-53:IA-5",
    "std:NIST_800-53:SC-12",
    "std:ISO27001:A.5.17",
    "std:ISO27001:A.8.3",
    "std:SOC2:CC6.1",
    "std:CMMC:AC.L2-3.1.1",
    "std:CMMC:IA.L2-3.5.10",
    "std:PCI_DSS_4:2.2.6",
    "std:PCI_DSS_4:8.3.2",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(5)(ii)(D)",
    "std:HIPAA:164.312(a)(1)",
    "std:HIPAA:164.312(a)(2)(iv)",
    "std:HIPAA:164.312(d)",
    "std:HIPAA:164.312(e)(2)(ii)",
    "std:NIST_CSF_2:PR.AA-01",
    "std:NIST_CSF_2:PR.AA-05",
    "std:NIST_CSF_2:PR.DS-01",
    "std:NIST_CSF_2:PR.DS-02",
    "cat:access_control",
    "env:linux",
    "env:host_level",
    "risk:high"
  ]
}

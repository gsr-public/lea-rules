{
  "name": "su Restricted to an Administrative Group (pam_wheel)",
  "description": "Ensures /etc/pam.d/su requires membership of an administrative group (auth required pam_wheel.so use_uid), so ordinary users cannot become root with su even if they learn the root password.",
  "active": true,
  "category": "access_control",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/pam.d/su",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^[ \\t]*auth[ \\t]+(?:required|requisite)[ \\t]+pam_wheel\\.so\\b[^\\n]*\\buse_uid\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:5.4",
    "std:NIST_800-53:AC-6",
    "std:ISO27001:A.8.2",
    "std:SOC2:CC6.3",
    "std:CMMC:AC.L2-3.1.7",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.312(a)(1)",
    "std:NIST_CSF_2:PR.AA-05",
    "cat:access_control",
    "env:linux",
    "env:host_level",
    "risk:medium"
  ]
}

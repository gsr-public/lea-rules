{
  "name": "Sudo Authentication Timeout 15 Minutes or Less",
  "description": "Ensures no sudoers Defaults line sets timestamp_timeout to more than 15 minutes or to a negative value (never expires). The default is 15 minutes or less on supported distributions.\nRequired sudo rule: allow user lea to run ONLY this exact command without a password: lea ALL=(root) NOPASSWD: /bin/cat /etc/sudoers /etc/sudoers.d/*",
  "active": true,
  "category": "access_control",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/sudoers /etc/sudoers.d/* 2>/dev/null",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\S"
        },
        "not_re": {
          "stdout": "(?mi)^[ \\t]*Defaults\\b[^\\n]*\\btimestamp_timeout[ \\t]*=[ \\t]*(?:-|(?:1[6-9]|[2-9]\\d|[1-9]\\d{2,})\\b)"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.3",
    "std:NIST_800-53:AC-6",
    "std:NIST_800-53:AC-11",
    "std:NIST_800-53:AC-12",
    "std:ISO27001:A.8.1",
    "std:SOC2:CC6.1",
    "std:CMMC:AC.L2-3.1.10",
    "std:CMMC:AC.L2-3.1.11",
    "std:PCI_DSS_4:8.2.8",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.312(a)(1)",
    "std:HIPAA:164.312(a)(2)(iii)",
    "std:NIST_CSF_2:PR.AA-03",
    "std:NIST_CSF_2:PR.AA-05",
    "cat:access_control",
    "env:linux",
    "env:host_level",
    "risk:medium",
    "priv:required"
  ]
}

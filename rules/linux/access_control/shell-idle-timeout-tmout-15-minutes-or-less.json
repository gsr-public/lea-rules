{
  "uid": "9bb03844-368b-4bc3-9806-ed2b787cec13",
  "name": "Shell Idle Timeout (TMOUT) 15 Minutes or Less",
  "description": "Ensures system-wide shell profiles set TMOUT to between 1 and 900 seconds and mark it readonly, so idle interactive shells, including root shells, are terminated automatically.",
  "active": true,
  "category": "access_control",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/profile /etc/profile.d/*.sh /etc/bashrc /etc/bash.bashrc 2>/dev/null",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^[ \\t]*(?:(?:readonly|export|declare[ \\t]+-[a-z]*)[ \\t]+)*TMOUT=(?:[1-9]|[1-9]\\d|[1-8]\\d{2}|900)\\b"
        }
      },
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^[ \\t]*(?:readonly[ \\t]+(?:TMOUT\\b|TMOUT=)|declare[ \\t]+-[a-z]*r[a-z]*[ \\t]+TMOUT\\b|typeset[ \\t]+-[a-z]*r[a-z]*[ \\t]+TMOUT\\b)"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.3",
    "std:NIST_800-53:AC-11",
    "std:NIST_800-53:AC-12",
    "std:ISO27001:A.8.1",
    "std:SOC2:CC6.1",
    "std:CMMC:AC.L2-3.1.10",
    "std:CMMC:AC.L2-3.1.11",
    "std:PCI_DSS_4:8.2.8",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.312(a)(2)(iii)",
    "std:NIST_CSF_2:PR.AA-03",
    "cat:access_control",
    "env:linux",
    "env:host_level",
    "risk:medium"
  ]
}

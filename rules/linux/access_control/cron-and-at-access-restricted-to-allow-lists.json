{
  "name": "Cron and at Access Restricted to Allow Lists",
  "description": "Ensures /etc/cron.allow exists, is owned by root (group root or crontab) and is mode 640 or stricter, and that /etc/cron.deny, /etc/at.allow and /etc/at.deny, where present, are equally restricted, so only listed users can schedule jobs. stat reads metadata only.",
  "active": true,
  "category": "access_control",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "stat -c '%n %a %U %G' /etc/cron.allow /etc/cron.deny /etc/at.allow /etc/at.deny 2>/dev/null",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^/etc/cron\\.allow [0-6][04]0 root (?:root|crontab)$"
        },
        "not_re": {
          "stdout": "(?m)^/etc/(?:cron|at)\\.(?:allow|deny) (?![0-6][04]0 root (?:root|crontab|daemon)$)"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:5.4",
    "std:NIST_800-53:AC-3",
    "std:NIST_800-53:AC-6",
    "std:ISO27001:A.8.2",
    "std:SOC2:CC6.3",
    "std:CMMC:AC.L2-3.1.5",
    "std:CMMC:AC.L2-3.1.7",
    "std:PCI_DSS_4:7.2.2",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.312(a)(1)",
    "std:NIST_CSF_2:PR.AA-05",
    "cat:access_control",
    "env:linux",
    "env:host_level",
    "risk:low"
  ]
}

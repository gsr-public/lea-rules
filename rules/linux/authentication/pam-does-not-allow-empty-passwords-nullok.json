{
  "uid": "f2f0a1d2-eb53-443d-ad22-e7a6d459d36b",
  "name": "PAM Does Not Allow Empty Passwords (nullok)",
  "description": "Ensures no pam_unix line in the Debian common-* or RHEL system-auth/password-auth stacks carries the nullok option, which lets accounts with an empty password log in.",
  "active": true,
  "category": "authentication",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/pam.d/common-auth /etc/pam.d/common-password /etc/pam.d/common-account 2>/dev/null",
        "system": [
          "Linux"
        ],
        "distribution": [
          "Ubuntu",
          "Debian GNU/Linux"
        ]
      },
      {
        "command": "cat /etc/pam.d/system-auth /etc/pam.d/password-auth 2>/dev/null",
        "system": [
          "Linux"
        ],
        "distribution": [
          "Red Hat Enterprise Linux",
          "CentOS Linux",
          "CentOS Stream",
          "Fedora Linux",
          "Oracle Linux Server",
          "Amazon Linux",
          "Rocky Linux",
          "AlmaLinux"
        ]
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [
          "Ubuntu",
          "Debian GNU/Linux"
        ],
        "re": {
          "stdout": "\\S"
        },
        "not_re": {
          "stdout": "(?m)^[ \\t]*[a-z-]+[ \\t]+[^#\\n]*\\bpam_unix\\.so\\b[^\\n]*\\bnullok\\b"
        }
      },
      {
        "system": [
          "Linux"
        ],
        "distribution": [
          "Red Hat Enterprise Linux",
          "CentOS Linux",
          "CentOS Stream",
          "Fedora Linux",
          "Oracle Linux Server",
          "Amazon Linux",
          "Rocky Linux",
          "AlmaLinux"
        ],
        "re": {
          "stdout": "\\S"
        },
        "not_re": {
          "stdout": "(?m)^[ \\t]*[a-z-]+[ \\t]+[^#\\n]*\\bpam_unix\\.so\\b[^\\n]*\\bnullok\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },

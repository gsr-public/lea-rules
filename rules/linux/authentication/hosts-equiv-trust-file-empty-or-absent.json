{
  "name": "hosts.equiv Trust File Empty or Absent",
  "description": "Ensures /etc/hosts.equiv does not exist or contains no active entries. Entries grant password-less rsh/rlogin trust to whole hosts.",
  "active": true,
  "category": "authentication",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/hosts.equiv",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "not_re": {
          "stdout": "(?m)^[ \\t]*[^#\\s]"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:NIST_800-53:AC-17",
    "std:NIST_800-53:IA-2",
    "std:ISO27001:A.8.5",
    "std:SOC2:CC6.1",
    "std:CMMC:AC.L2-3.1.12",
    "std:CMMC:IA.L2-3.5.2",
    "std:PCI_DSS_4:2.2.7",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "cat:authentication",
    "env:linux",
    "env:host_level",
    "risk:high"
  ]
}

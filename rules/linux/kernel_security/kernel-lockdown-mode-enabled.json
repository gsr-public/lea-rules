{
  "name": "Kernel Lockdown Mode Enabled",
  "description": "Ensures the kernel lockdown LSM is in integrity or confidentiality mode (/sys/kernel/security/lockdown), which stops even root from modifying the running kernel through /dev/mem, unsigned modules, kexec or hibernation images. Most distributions enable integrity mode automatically under Secure Boot.",
  "active": true,
  "category": "kernel_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /sys/kernel/security/lockdown",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\[(?:integrity|confidentiality)\\]"

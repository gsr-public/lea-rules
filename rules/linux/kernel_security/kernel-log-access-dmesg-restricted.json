{
  "name": "Kernel Log Access (dmesg) Restricted",
  "description": "Ensures unprivileged users cannot read the kernel message buffer (kernel.dmesg_restrict = 1), which can leak kernel addresses and hardware details useful to an attacker.\nRequired sudo rule (remedy only): allow user lea to run ONLY this exact command without a password: lea ALL=(root) NOPASSWD: /sbin/sysctl -w kernel.dmesg_restrict=1",
  "active": true,
  "category": "kernel_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /proc/sys/kernel/dmesg_restrict",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "^1$"
        }
      }
    ],
    "remedy": [
      {
        "command": "sysctl -w kernel.dmesg_restrict=1 >/dev/null && cat /proc/sys/kernel/dmesg_restrict",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.1",
    "std:NIST_800-53:CM-6",
    "std:NIST_800-53:SI-7",
    "std:NIST_800-53:SI-11",
    "std:ISO27001:A.8.9",
    "std:SOC2:CC7.1",
    "std:CMMC:CM.L2-3.4.2",
    "std:PCI_DSS_4:2.2.6",
    "std:NIS2:Art21.2(e)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(1)(ii)(B)",
    "std:HIPAA:164.312(c)(1)",
    "std:NIST_CSF_2:DE.CM-09",
    "std:NIST_CSF_2:PR.DS-01",
    "std:NIST_CSF_2:PR.PS-01",
    "cat:kernel_security",
    "env:linux",
    "env:host_level",
    "risk:medium"
  ]
}

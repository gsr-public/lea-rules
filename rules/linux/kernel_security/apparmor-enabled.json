{
  "name": "AppArmor Enabled",
  "description": "Checks that the AppArmor Linux Security Module is enabled in the running kernel (/sys/module/apparmor/parameters/enabled reports Y) on distributions that use AppArmor. Reading this file needs no privileges, unlike apparmor_status.",
  "active": true,
  "category": "kernel_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /sys/module/apparmor/parameters/enabled",
        "system": [
          "Linux"
        ],
        "distribution": [
          "Ubuntu",
          "Debian GNU/Linux",
          "SLES",
          "openSUSE Leap",
          "openSUSE Tumbleweed",
          "Linux Mint"
        ]
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [
          "Ubuntu",
          "Debian GNU/Linux",
          "SLES",
          "openSUSE Leap",
          "openSUSE Tumbleweed",
          "Linux Mint"
        ],
        "re": {
          "stdout": "\\AY\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.1",
    "std:NIST_800-53:AC-3",
    "std:NIST_800-53:CM-6",
    "std:ISO27001:A.8.9",
    "std:SOC2:CC6.8",
    "std:SOC2:CC7.1",
    "std:CMMC:CM.L2-3.4.2",
    "std:PCI_DSS_4:2.2.6",
    "std:NIS2:Art21.2(e)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(1)(ii)(B)",
    "std:HIPAA:164.312(a)(1)",
    "std:NIST_CSF_2:PR.AA-05",
    "std:NIST_CSF_2:PR.PS-01",
    "cat:kernel_security",
    "env:linux",
    "env:host_level",
    "risk:high"
  ]
}

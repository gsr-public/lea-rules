{
  "uid": "fe008d2f-e1fd-4e94-b62b-4b65b8ab8584",
  "name": "Kernel Protected Regular Files Enforced",
  "former_names": [
    "Linux Protected Regular Files Strict"
  ],
  "description": "Ensures fs.protected_regular is configured in a restrictive mode (1 or 2), protecting regular files from being opened in unsafe ways.",
  "active": true,
  "category": "kernel_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /proc/sys/fs/protected_regular",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "^(?:1|2)$"
        }
      }
    ],
    "_remedy": [
      {
        "command": "sysctl -w fs.protected_regular=2 >/dev/null && cat /proc/sys/fs/protected_regular",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "system": []
  },

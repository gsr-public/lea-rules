{
  "name": "Kernel Protected Symlinks Enabled",
  "description": "Ensures fs.protected_symlinks is enabled (1), restricting unsafe symlink following by unprivileged users.",
  "active": true,
  "category": "kernel_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /proc/sys/fs/protected_symlinks",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "^1$"
        }
      }
    ],
    "remedy": [
      {
        "command": "sysctl -w fs.protected_symlinks=1 >/dev/null && cat /proc/sys/fs/protected_symlinks",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "system": []
  },

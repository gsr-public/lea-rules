{
  "name": "UDF Filesystem Module Not Loaded",
  "description": "Ensures the udf filesystem kernel module is not loaded (checked in /proc/modules). Unused filesystem drivers add kernel attack surface that can be reached by mounting crafted media. A driver compiled into the kernel is not detected. Microsoft Azure uses UDF for VM provisioning media; exclude Azure VMs.",
  "active": true,
  "category": "kernel_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /proc/modules",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\S"
        },
        "not_re": {
          "stdout": "(?m)^udf[ \\t]"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.8",
    "std:NIST_800-53:CM-7",
    "std:ISO27001:A.8.9",
    "std:SOC2:CC6.6",
    "std:CMMC:CM.L2-3.4.6",
    "std:CMMC:CM.L2-3.4.7",
    "std:PCI_DSS_4:2.2.4",
    "std:NIS2:Art21.2(e)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(1)(ii)(B)",
    "std:NIST_CSF_2:PR.PS-01",
    "cat:kernel_security",
    "env:linux",
    "env:host_level",
    "risk:low"
  ]
}

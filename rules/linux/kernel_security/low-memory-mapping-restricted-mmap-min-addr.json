{
  "uid": "04be793f-da96-41a7-ae7e-23b8517d7eed",
  "name": "Low Memory Mapping Restricted (mmap_min_addr)",
  "former_names": [
    "Linux mmap Minimum Address Hardened"
  ],
  "description": "Ensures vm.mmap_min_addr is configured to a hardened minimum address (>= 4096), making it harder for userland processes to map low memory addresses.",
  "active": true,
  "category": "kernel_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /proc/sys/vm/mmap_min_addr",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "^(?:[4-9][0-9]{3}|[1-9][0-9]{4,})$"
        }
      }
    ],
    "_remedy": [
      {
        "command": "sysctl -w vm.mmap_min_addr=65536 >/dev/null && cat /proc/sys/vm/mmap_min_addr",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "system": []
  },
  "parameters": [],

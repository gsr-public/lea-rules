{
  "uid": "6793744f-6430-40b7-a162-adc2bf0298ca",
  "name": "Ptrace Scope Restricted (Yama)",
  "former_names": [
    "Linux Yama Ptrace Scope Restricted"
  ],
  "description": "Ensures kernel.yama.ptrace_scope is 1, 2 or 3, so processes cannot attach to and read the memory of unrelated processes owned by the same user. Fails if the Yama LSM is not available, because ptrace is then unrestricted.\nRequired sudo rule (remedy only): allow user lea to run ONLY this exact command without a password: lea ALL=(root) NOPASSWD: /sbin/sysctl -w kernel.yama.ptrace_scope=1",
  "active": true,
  "category": "kernel_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /proc/sys/kernel/yama/ptrace_scope",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "^[1-3]$"
        }
      }
    ],
    "_remedy": [
      {
        "command": "sysctl -w kernel.yama.ptrace_scope=1 >/dev/null && cat /proc/sys/kernel/yama/ptrace_scope",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:10.5",

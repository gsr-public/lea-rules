{
  "uid": "300b016a-5be3-4845-9f9e-95d1205ea175",
  "name": "Boot Loader Configuration Permissions Restricted",
  "description": "Ensures the GRUB configuration (/boot/grub/grub.cfg or /boot/grub2/grub.cfg) is owned by root and readable only by root (mode 600 or 400), so boot parameters and password hashes are not exposed to or changed by other users. stat reads metadata only.",
  "active": true,
  "category": "kernel_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "stat -c '%n %a %U %G' /boot/grub/grub.cfg /boot/grub2/grub.cfg 2>/dev/null",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\S"
        },
        "not_re": {
          "stdout": "(?m)^(?!LEA_RULE_no_service)\\S+ (?!(?:[46]00 root root)$)"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:3.3",
    "std:NIST_800-53:AC-3",
    "std:NIST_800-53:CM-6",
    "std:ISO27001:A.8.3",
    "std:SOC2:CC6.1",
    "std:CMMC:AC.L2-3.1.1",
    "std:PCI_DSS_4:2.2.6",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(1)(ii)(B)",
    "std:HIPAA:164.312(a)(1)",
    "std:NIST_CSF_2:PR.AA-05",
    "std:NIST_CSF_2:PR.PS-01",
    "cat:kernel_security",
    "env:linux",
    "env:host_level",
    "risk:medium"
  ]
}

{
  "name": "System Accounts Have Locked Passwords",
  "description": "Ensures system accounts (UID 1-999) in /etc/shadow have a locked or disabled password field (! or *), so they cannot authenticate with a password. Cross-checks the shadow file against UID ranges from /etc/passwd.\nRequired sudo rule: allow user lea to run ONLY this exact command without a password: lea ALL=(root) NOPASSWD: /bin/cat /etc/passwd /etc/shadow",
  "active": true,
  "category": "identity_management",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/passwd; echo 'LEA_SHADOW'; cat /etc/shadow",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^LEA_SHADOW$[\\s\\S]*^root:"
        },
        "not_re": {
          "stdout": "(?m)^([^:\\n]+):[^:\\n]*:(?:[1-9]|[1-9]\\d|[1-9]\\d{2}):(?=[\\s\\S]*^LEA_SHADOW$)(?=[\\s\\S]*^LEA_SHADOW$[\\s\\S]*^\\1:(?![!*])[^:\\n]+:)"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.7",
    "std:NIST_800-53:AC-2",
    "std:ISO27001:A.5.18",
    "std:SOC2:CC6.2",
    "std:CMMC:AC.L2-3.1.1",
    "std:PCI_DSS_4:2.2.2",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(4)(ii)(C)",
    "std:HIPAA:164.312(a)(1)",
    "std:NIST_CSF_2:PR.AA-01",
    "std:NIST_CSF_2:PR.AA-05",
    "cat:identity_management",
    "env:linux",
    "env:host_level",
    "risk:medium",
    "priv:required"
  ]
}

{
  "name": "Password Hashes Not Stored in /etc/passwd",
  "description": "Ensures every account in the world-readable /etc/passwd has a placeholder ('x', '*' or '!') in the password field, so password hashes live only in /etc/shadow. Empty fields and legacy '+' NIS entries also fail.",
  "active": true,
  "category": "identity_management",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/passwd",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^root:"
        },
        "not_re": {
          "stdout": "(?m)^[^:\\n]+:(?![x*!]:)[^:\\n]*:"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:NIST_800-53:IA-5",
    "std:ISO27001:A.5.17",
    "std:SOC2:CC6.1",
    "std:CMMC:IA.L2-3.5.10",
    "std:PCI_DSS_4:8.3.2",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(5)(ii)(D)",
    "std:HIPAA:164.312(d)",
    "std:NIST_CSF_2:PR.AA-01",
    "cat:identity_management",
    "env:linux",
    "env:host_level",
    "risk:high"
  ]
}

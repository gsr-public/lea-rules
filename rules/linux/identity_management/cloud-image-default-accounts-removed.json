{
  "name": "Cloud Image Default Accounts Removed",
  "description": "Ensures well-known default accounts created by cloud images (ubuntu, ec2-user, centos, cloud-user, fedora, rocky, almalinux, debian, opc) are not present in /etc/passwd. Shared, predictable account names should be replaced with named personal accounts.",
  "active": true,
  "category": "identity_management",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/passwd",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^root:"
        },
        "not_re": {
          "stdout": "(?m)^(?:ubuntu|ec2-user|centos|cloud-user|fedora|rocky|almalinux|debian|opc):"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.7",
    "std:NIST_800-53:AC-2",
    "std:ISO27001:A.5.18",
    "std:SOC2:CC6.2",
    "std:CMMC:AC.L2-3.1.1",
    "std:PCI_DSS_4:2.2.2",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(4)(ii)(C)",
    "std:HIPAA:164.312(a)(1)",
    "std:NIST_CSF_2:PR.AA-01",
    "std:NIST_CSF_2:PR.AA-05",
    "cat:identity_management",
    "env:linux",
    "env:host_level",
    "risk:medium"
  ]
}

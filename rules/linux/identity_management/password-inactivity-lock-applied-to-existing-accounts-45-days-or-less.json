{
  "name": "Password Inactivity Lock Applied to Existing Accounts (45 Days or Less)",
  "description": "Ensures every account with a password hash in /etc/shadow is disabled no more than 45 days after its password expires (shadow inactive field 0-45).\nRequired sudo rule: allow user lea to run ONLY this exact command without a password: lea ALL=(root) NOPASSWD: /bin/cat /etc/shadow",
  "active": true,
  "category": "identity_management",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/shadow",
        "system": [
          "Linux"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^root:"
        },
        "not_re": {
          "stdout": "(?m)^[^:\\n]+:\\$[^:\\n]+:[^:\\n]*:[^:\\n]*:[^:\\n]*:[^:\\n]*:(?!(?:[0-9]|[1-3]\\d|4[0-5]):)[^:\\n]*:"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:5.3",
    "std:NIST_800-53:AC-2",
    "std:ISO27001:A.5.18",
    "std:SOC2:CC6.2",
    "std:CMMC:AC.L2-3.1.1",
    "std:PCI_DSS_4:8.2.6",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(4)(ii)(C)",
    "std:HIPAA:164.312(a)(1)",
    "std:NIST_CSF_2:PR.AA-01",
    "std:NIST_CSF_2:PR.AA-05",
    "cat:identity_management",
    "env:linux",
    "env:host_level",
    "risk:low",
    "priv:required"
  ]
}

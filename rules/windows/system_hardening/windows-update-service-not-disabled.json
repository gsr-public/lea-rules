{
  "uid": "4b0ab7cc-b5b7-4140-9516-c73e9ac4ed32",
  "name": "Windows Update Service Not Disabled",
  "description": "Ensures the Windows Update service (wuauserv) is not disabled (Start not 4), so security updates can be installed.",
  "active": true,
  "category": "system_hardening",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query HKLM\\SYSTEM\\CurrentControlSet\\Services\\wuauserv /v Start",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]+Start[ \\t]+REG_DWORD[ \\t]+0x[0-3]\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },

{
  "name": "Windows Diagnostic Data Limited to Required",
  "description": "Ensures Windows diagnostic data is limited to Required/Basic or off (AllowTelemetry 0 or 1), reducing data sent to Microsoft.",
  "active": true,
  "category": "system_hardening",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection\" /v AllowTelemetry",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]+AllowTelemetry[ \\t]+REG_DWORD[ \\t]+0x(?:0|1)\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:NIST_800-53:CM-7",
    "std:ISO27001:A.5.34",
    "std:ISO27001:A.8.12",
    "std:SOC2:CC6.7",
    "std:CMMC:CM.L2-3.4.6",
    "std:NIS2:Art21.2(e)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(1)(ii)(B)",
    "std:NIST_CSF_2:PR.PS-01",
    "cat:system_hardening",
    "env:windows",
    "env:host_level",
    "risk:low"
  ]
}

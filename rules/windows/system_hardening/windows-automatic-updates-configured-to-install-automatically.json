{
  "uid": "e1df1b63-1b77-4fa7-a560-8dd5e6d84ecb",
  "name": "Windows Automatic Updates Configured to Install Automatically",
  "description": "Ensures Automatic Updates downloads and installs updates on a schedule (AUOptions = 4), unless management by another tool (WSUS approval, Intune) is documented.",
  "active": true,
  "category": "system_hardening",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU\" /v AUOptions",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]+AUOptions[ \\t]+REG_DWORD[ \\t]+0x(?:4)\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:7.3",
    "std:NIST_800-53:SI-2",
    "std:ISO27001:A.8.8",
    "std:SOC2:CC7.1",
    "std:CMMC:SI.L2-3.14.1",
    "std:PCI_DSS_4:6.3.3",
    "std:NIS2:Art21.2(e)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(1)(ii)(B)",
    "std:NIST_CSF_2:ID.RA-01",
    "std:NIST_CSF_2:PR.PS-02",
    "std:ASD_E8:patch_os",
    "cat:system_hardening",
    "env:windows",
    "env:host_level",
    "risk:medium"
  ]
}

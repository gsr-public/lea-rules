{
  "uid": "b6b8f3bb-42fd-4678-9b6b-9b311fafb280",
  "name": "Windows Lock Screen Camera Disabled",
  "description": "Ensures the camera cannot be used from the lock screen (NoLockScreenCamera = 1).",
  "active": true,
  "category": "system_hardening",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\Personalization\" /v NoLockScreenCamera",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]+NoLockScreenCamera[ \\t]+REG_DWORD[ \\t]+0x(?:1)\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],

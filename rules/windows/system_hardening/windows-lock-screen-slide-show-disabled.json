{
  "uid": "65d42a4f-1598-4801-abf5-8bea68c6feae",
  "name": "Windows Lock Screen Slide Show Disabled",
  "description": "Ensures the lock screen slide show is disabled (NoLockScreenSlideshow = 1), so pictures are not displayed on a locked device.",
  "active": true,
  "category": "system_hardening",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\Personalization\" /v NoLockScreenSlideshow",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]+NoLockScreenSlideshow[ \\t]+REG_DWORD[ \\t]+0x(?:1)\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],

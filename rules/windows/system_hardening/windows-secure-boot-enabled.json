{
  "name": "Windows Secure Boot Enabled",
  "description": "Ensures UEFI Secure Boot is enabled (Confirm-SecureBootUEFI returns True), so only signed boot loaders and kernels start.\nRequired Windows permission: LEA agent account must be allowed to run only: Confirm-SecureBootUEFI (administrator rights) via a delegated run-as permission, Scheduled Task, or service configuration.",
  "active": true,
  "category": "system_hardening",
  "cycle": 3600,
  "cmd_info_key": null,

{
  "uid": "eb18ca90-29d1-4c43-b504-8a668a62c11a",
  "name": "Windows Safe DLL Search Mode Enabled",
  "description": "Ensures Safe DLL search mode is not disabled (SafeDllSearchMode not 0), so the system directory is searched before the current directory, mitigating DLL planting. An absent value (default) passes.",
  "active": true,
  "category": "system_hardening",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\" /v SafeDllSearchMode",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "not_re": {
          "stdout": "(?mi)^[ \\t]+SafeDllSearchMode[ \\t]+REG_DWORD[ \\t]+(?!0x(?:1)\\b)0x[0-9a-f]+"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:10.5",
    "std:NIST_800-53:CM-6",
    "std:NIST_800-53:SI-16",
    "std:ISO27001:A.8.9",
    "std:SOC2:CC6.8",
    "std:CMMC:CM.L2-3.4.2",
    "std:PCI_DSS_4:2.2.6",
    "std:NIS2:Art21.2(e)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(1)(ii)(B)",
    "std:NIST_CSF_2:PR.PS-01",
    "cat:system_hardening",
    "env:windows",
    "env:host_level",
    "risk:medium"
  ]
}

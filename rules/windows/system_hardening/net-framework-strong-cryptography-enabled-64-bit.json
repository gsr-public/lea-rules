{
  "name": ".NET Framework Strong Cryptography Enabled (64-bit)",
  "description": "Ensures the .NET Framework 4.x 64-bit runtime is configured to use strong cryptography (SchUseStrongCrypto=1).",
  "active": true,
  "category": "system_hardening",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query HKLM\\SOFTWARE\\Microsoft\\.NETFramework\\v4.0.30319 /v SchUseStrongCrypto",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "SchUseStrongCrypto\\s+REG_DWORD\\s+0x1\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },

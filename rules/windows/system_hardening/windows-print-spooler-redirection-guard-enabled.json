{
  "name": "Windows Print Spooler Redirection Guard Enabled",
  "description": "Ensures Redirection Guard is enabled for the print spooler (RedirectionGuardPolicy = 1), blocking file redirection abuse.",
  "active": true,
  "category": "system_hardening",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\Printers\" /v RedirectionGuardPolicy",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]+RedirectionGuardPolicy[ \\t]+REG_DWORD[ \\t]+0x(?:1)\\b"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],

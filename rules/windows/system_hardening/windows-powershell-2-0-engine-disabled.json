{
  "uid": "be5176bb-5be5-4647-ae31-7c3e7e80179f",
  "name": "Windows PowerShell 2.0 Engine Disabled",
  "description": "Ensures the Windows PowerShell 2.0 engine is not enabled. PowerShell 2.0 lacks script block logging and AMSI and is used to downgrade attacks. Passes when the feature is disabled or not present (Windows 11 24H2 and later).\nRequired Windows permission: the LEA agent account must be allowed to run Get-WindowsOptionalFeature -Online (administrator rights) via a delegated run-as permission, Scheduled Task, or service configuration.",
  "active": true,
  "category": "system_hardening",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "Get-WindowsOptionalFeature -Online -FeatureName MicrosoftWindowsPowerShellV2Root | Format-List -Property FeatureName,State",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "not_re": {
          "stdout": "(?m)^State[ \\t]*:[ \\t]*Enable"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.8",

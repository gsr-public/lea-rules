    "std:HIPAA:164.308(a)(1)(ii)(B)",
    "std:NIST_CSF_2:PR.PS-01",
    "std:ASD_E8:user_application_hardening",
    "cat:system_hardening",
    "env:windows",
    "env:host_level",
    "risk:high",
    "priv:required"
  ]
}

{
  "name": "Windows FIPS-Compliant Algorithms Enforced",
  "description": "Ensures the Windows FIPS algorithm policy is enabled (FipsAlgorithmPolicy Enabled=1), restricting the host to approved cryptographic algorithms.",
  "active": true,
  "category": "system_hardening",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa\\FipsAlgorithmPolicy /v Enabled",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "Enabled\\s+REG_DWORD\\s+0x1\\b"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],

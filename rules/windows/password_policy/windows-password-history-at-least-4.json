{
  "uid": "dc4bde89-98dc-44a7-be89-de11ee18dde8",
  "name": "Windows Password History At Least 4",
  "former_names": [
    "Windows Password History Size"
  ],
  "description": "Ensures Windows password policy enforces a password history size to prevent reuse of a small set of passwords.",
  "active": true,
  "category": "password_policy",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "net accounts",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^\\s*Length\\s+of\\s+password\\s+history\\s+maintained\\s*:\\s*(?:[4-9]|[1-9][0-9])\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],

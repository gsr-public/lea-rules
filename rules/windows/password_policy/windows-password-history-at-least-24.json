{
  "name": "Windows Password History At Least 24",
  "description": "Ensures the local password policy remembers at least 24 previous passwords (net accounts \"Length of password history maintained\").",
  "active": true,
  "category": "password_policy",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "net accounts",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^\\s*Length\\s+of\\s+password\\s+history\\s+maintained\\s*:\\s*(?:2[4-9]|[3-9]\\d|[1-9]\\d{2})\\s*\\r?$"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:5.2",
    "std:NIST_800-53:IA-5",
    "std:ISO27001:A.5.17",
    "std:SOC2:CC6.1",
    "std:CMMC:IA.L2-3.5.8",
    "std:PCI_DSS_4:8.3.7",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(5)(ii)(D)",
    "std:HIPAA:164.312(d)",
    "std:NIST_CSF_2:PR.AA-01",
    "cat:password_policy",
    "env:windows",
    "env:host_level",
    "risk:medium"
  ]
}

{
  "name": "Windows PowerShell Module Logging Enabled",
  "description": "Ensures PowerShell module logging is enabled by policy, recording pipeline execution details. Module names to log are configured separately under the ModuleNames subkey.",
  "active": true,
  "category": "audit",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {

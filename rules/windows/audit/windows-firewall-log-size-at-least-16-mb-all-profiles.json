{
  "name": "Windows Firewall Log Size At Least 16 MB (All Profiles)",
  "description": "Ensures the Windows Firewall log for every profile can grow to at least 16,384 KB.",
  "active": true,
  "category": "audit",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "netsh advfirewall show allprofiles",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "Domain Profile Settings:(?:(?!Profile Settings:)[\\s\\S])*?MaxFileSize[ \\t]+(?:1638[4-9]|1639\\d|16[4-9]\\d{2}|1[7-9]\\d{3}|[2-9]\\d{4}|[1-9]\\d{5,})\\b"
        }
      },
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "Private Profile Settings:(?:(?!Profile Settings:)[\\s\\S])*?MaxFileSize[ \\t]+(?:1638[4-9]|1639\\d|16[4-9]\\d{2}|1[7-9]\\d{3}|[2-9]\\d{4}|[1-9]\\d{5,})\\b"
        }
      },
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "Public Profile Settings:(?:(?!Profile Settings:)[\\s\\S])*?MaxFileSize[ \\t]+(?:1638[4-9]|1639\\d|16[4-9]\\d{2}|1[7-9]\\d{3}|[2-9]\\d{4}|[1-9]\\d{5,})\\b"
        }

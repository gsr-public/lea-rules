  "uid": "56f706de-df68-4875-bfdb-88b69a89ce4e",
  "name": "Windows Firewall Logs Dropped Packets (All Profiles)",
  "description": "Ensures Windows Firewall logging of dropped packets is enabled for the Domain, Private and Public profiles.",
  "active": true,
  "category": "audit",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "netsh advfirewall show allprofiles",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "Domain Profile Settings:(?:(?!Profile Settings:)[\\s\\S])*?LogDroppedConnections[ \\t]+Enable\\b"
        }
      },
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "Private Profile Settings:(?:(?!Profile Settings:)[\\s\\S])*?LogDroppedConnections[ \\t]+Enable\\b"
        }
      },
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "Public Profile Settings:(?:(?!Profile Settings:)[\\s\\S])*?LogDroppedConnections[ \\t]+Enable\\b"
        }
      }
    ],

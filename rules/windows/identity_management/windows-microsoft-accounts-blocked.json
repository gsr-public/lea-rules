{
  "name": "Windows Microsoft Accounts Blocked",
  "description": "Ensures users cannot add or log on with Microsoft consumer accounts (NoConnectedUser = 3).",
  "active": true,
  "category": "identity_management",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\" /v NoConnectedUser",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]+NoConnectedUser[ \\t]+REG_DWORD[ \\t]+0x(?:3)\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],

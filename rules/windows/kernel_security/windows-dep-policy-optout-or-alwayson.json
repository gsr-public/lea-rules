{
  "name": "Windows DEP Policy OptOut or AlwaysOn",
  "description": "Ensures Data Execution Prevention applies system-wide (boot configuration nx OptOut or AlwaysOn), not only to Windows components.\nRequired Windows permission: the LEA agent account must be allowed to run bcdedit /enum '{current}' (administrator rights) via a delegated run-as permission, Scheduled Task, or service configuration.",
  "active": true,
  "category": "kernel_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "bcdedit /enum '{current}'",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^nx[ \\t]+(?:OptOut|AlwaysOn)[ \\t]*\\r?$"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:10.5",
    "std:NIST_800-53:CM-6",
    "std:NIST_800-53:SI-16",
    "std:ISO27001:A.8.9",
    "std:SOC2:CC6.8",
    "std:CMMC:CM.L2-3.4.2",
    "std:PCI_DSS_4:2.2.6",
    "std:NIS2:Art21.2(e)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(1)(ii)(B)",
    "std:NIST_CSF_2:PR.PS-01",
    "cat:kernel_security",
    "env:windows",
    "env:host_level",
    "risk:high",
    "priv:required"
  ]
}

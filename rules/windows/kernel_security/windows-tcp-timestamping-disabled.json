{
  "uid": "13dda79f-b3c4-4857-a67e-f7d610acde49",
  "name": "Windows TCP Timestamping Disabled",
  "description": "Ensures TCP timestamps are disabled (Tcp1323Opts = 0), reducing exposure to timestamp-based fingerprinting and uptime disclosure. Note that this value also disables TCP window scaling; review throughput impact before enforcing.",
  "active": true,
  "category": "kernel_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query HKLM\\SYSTEM\\CurrentControlSet\\Services\\Tcpip\\Parameters /v Tcp1323Opts",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "Tcp1323Opts\\s+REG_DWORD\\s+0x0\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],

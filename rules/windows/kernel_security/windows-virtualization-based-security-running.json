{
  "uid": "597e410b-14f7-4109-81ee-f11bd6a4a4b9",
  "name": "Windows Virtualization-Based Security Running",
  "description": "Ensures virtualization-based security is enabled and running (Win32_DeviceGuard VirtualizationBasedSecurityStatus = 2), the foundation for Credential Guard and memory integrity.",
  "active": true,
  "category": "kernel_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "Get-CimInstance -ClassName Win32_DeviceGuard -Namespace root\\Microsoft\\Windows\\DeviceGuard | Format-List -Property VirtualizationBasedSecurityStatus,SecurityServicesRunning",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^VirtualizationBasedSecurityStatus[ \\t]*:[ \\t]*2[ \\t]*\\r?$"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],

{
  "uid": "8d54e0cd-0553-4daf-ab20-f4aca6296c14",
  "name": "Windows Users Cannot Install Printer Drivers",
  "description": "Ensures standard users cannot install printer drivers when connecting to shared printers (AddPrinterDrivers = 1).",
  "active": true,
  "category": "access_control",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SYSTEM\\CurrentControlSet\\Control\\Print\\Providers\\LanMan Print Services\\Servers\" /v AddPrinterDrivers",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]+AddPrinterDrivers[ \\t]+REG_DWORD[ \\t]+0x(?:1)\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],

{
  "uid": "4889a458-5dd8-4af2-b475-c4318a0b4588",
  "name": "Windows Point and Print Requires Elevation Prompts",
  "description": "Ensures Point and Print shows warning and elevation prompts for new connections and driver updates (NoWarningNoElevationOnInstall and UpdatePromptSettings not 1 or 2).",
  "active": true,
  "category": "access_control",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\Printers\\PointAndPrint\"",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "not_re": {
          "stdout": "(?mi)^[ \\t]+(?:NoWarningNoElevationOnInstall|UpdatePromptSettings)[ \\t]+REG_DWORD[ \\t]+0x(?!0\\b)"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:5.4",
    "std:NIST_800-53:AC-6",
    "std:ISO27001:A.8.2",
    "std:SOC2:CC6.3",
    "std:CMMC:AC.L2-3.1.5",
    "std:CMMC:AC.L2-3.1.7",
    "std:PCI_DSS_4:7.2.2",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.312(a)(1)",
    "std:NIST_CSF_2:PR.AA-05",
    "cat:access_control",
    "env:windows",
    "env:host_level",
    "risk:high"
  ]
}

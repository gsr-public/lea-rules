{
  "name": "Windows RDP Encryption Level High",
  "description": "Ensures Remote Desktop sessions use the High (3) or FIPS-compliant (4) encryption level.",
  "active": true,
  "category": "access_control",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SYSTEM\\CurrentControlSet\\Control\\Terminal Server\\WinStations\\RDP-Tcp\" /v MinEncryptionLevel",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "MinEncryptionLevel\\s+REG_DWORD\\s+0x[34]\\b"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:3.10",
    "std:NIST_800-53:AC-17",
    "std:NIST_800-53:SC-8",
    "std:NIST_800-53:SC-13",
    "std:ISO27001:A.8.24",
    "std:SOC2:CC6.7",
    "std:CMMC:AC.L2-3.1.12",
    "std:CMMC:SC.L2-3.13.8",
    "std:CMMC:SC.L2-3.13.11",
    "std:PCI_DSS_4:2.2.7",
    "std:PCI_DSS_4:4.2.1",
    "std:NIS2:Art21.2(h)",
    "std:DORA:Art9",
    "cat:access_control",
    "env:windows",
    "env:host_level",
    "risk:medium"
  ]
}

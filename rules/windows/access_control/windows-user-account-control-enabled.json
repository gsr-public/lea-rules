  "name": "Windows User Account Control Enabled",
  "former_names": [
    "User Account Control Enabled"
  ],
  "description": "Verifies that User Account Control (UAC) is enabled to enforce elevation prompts for administrative actions.",
  "active": true,
  "category": "access_control",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query HKLM\\Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\System /v EnableLUA",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "EnableLUA\\s+REG_DWORD\\s+0x1\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],

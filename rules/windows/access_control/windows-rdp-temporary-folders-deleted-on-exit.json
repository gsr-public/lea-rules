{
  "name": "Windows RDP Temporary Folders Deleted on Exit",
  "description": "Ensures per-session temporary folders are deleted when the session ends (DeleteTempDirsOnExit = 1).",
  "active": true,
  "category": "access_control",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\Terminal Services\" /v DeleteTempDirsOnExit",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]+DeleteTempDirsOnExit[ \\t]+REG_DWORD[ \\t]+0x(?:1)\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.6",
    "std:NIST_800-53:AC-17",
    "std:ISO27001:A.8.5",
    "std:ISO27001:A.8.20",
    "std:SOC2:CC6.1",
    "std:SOC2:CC6.6",
    "std:CMMC:AC.L2-3.1.12",
    "std:PCI_DSS_4:2.2.7",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.312(a)(1)",
    "std:HIPAA:164.312(e)(1)",
    "std:NIST_CSF_2:PR.AA-05",
    "std:NIST_CSF_2:PR.IR-01",
    "cat:access_control",
    "env:windows",
    "env:host_level",
    "risk:low"
  ]
}

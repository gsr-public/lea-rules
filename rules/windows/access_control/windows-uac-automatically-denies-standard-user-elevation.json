{
  "name": "Windows UAC Automatically Denies Standard User Elevation",
  "description": "Ensures elevation requests from standard users are automatically denied (ConsentPromptBehaviorUser = 0), so users cannot be tricked into entering administrator credentials.",
  "active": true,
  "category": "access_control",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\" /v ConsentPromptBehaviorUser",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]+ConsentPromptBehaviorUser[ \\t]+REG_DWORD[ \\t]+0x(?:0)\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:5.4",
    "std:NIST_800-53:AC-6",
    "std:ISO27001:A.8.2",
    "std:SOC2:CC6.3",
    "std:CMMC:AC.L2-3.1.5",
    "std:CMMC:AC.L2-3.1.7",
    "std:PCI_DSS_4:7.2.2",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.312(a)(1)",
    "std:NIST_CSF_2:PR.AA-05",
    "std:ASD_E8:restrict_admin_privileges",
    "cat:access_control",
    "env:windows",
    "env:host_level",
    "risk:medium"
  ]
}

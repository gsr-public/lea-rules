{
  "name": "Windows Installer User Control Over Installs Disabled",
  "description": "Ensures users cannot change installation options normally reserved for administrators (EnableUserControl not 1).",
  "active": true,
  "category": "access_control",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\Installer\" /v EnableUserControl",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "not_re": {
          "stdout": "(?mi)^[ \\t]+EnableUserControl[ \\t]+REG_DWORD[ \\t]+(?!0x(?:0)\\b)0x[0-9a-f]+"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],

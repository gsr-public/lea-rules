{
  "name": "Windows RDP Clipboard Redirection Disabled",
  "description": "Ensures clipboard redirection is disabled for Remote Desktop sessions (fDisableClip = 1), preventing data exfiltration through copy and paste. Hosts where administrators need clipboard transfer can be excluded.",
  "active": true,
  "category": "access_control",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\Terminal Services\" /v fDisableClip",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]+fDisableClip[ \\t]+REG_DWORD[ \\t]+0x(?:1)\\b"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.6",
    "std:NIST_800-53:AC-17",
    "std:ISO27001:A.8.5",
    "std:ISO27001:A.8.20",
    "std:SOC2:CC6.1",
    "std:SOC2:CC6.6",
    "std:CMMC:AC.L2-3.1.12",
    "std:PCI_DSS_4:2.2.7",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.312(a)(1)",
    "std:HIPAA:164.312(e)(1)",
    "std:NIST_CSF_2:PR.AA-05",
    "std:NIST_CSF_2:PR.IR-01",
    "cat:access_control",
    "env:windows",
    "env:host_level",
    "risk:low"
  ]
}

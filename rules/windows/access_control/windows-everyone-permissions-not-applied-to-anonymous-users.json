{
  "uid": "f0c0352f-0d12-4fe9-90c9-05b855d622a2",
  "name": "Windows Everyone Permissions Not Applied to Anonymous Users",
  "description": "Ensures permissions granted to Everyone do not also apply to anonymous users (EveryoneIncludesAnonymous = 0).",
  "active": true,
  "category": "access_control",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa\" /v EveryoneIncludesAnonymous",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "not_re": {
          "stdout": "(?mi)^[ \\t]+EveryoneIncludesAnonymous[ \\t]+REG_DWORD[ \\t]+(?!0x(?:0)\\b)0x[0-9a-f]+"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],

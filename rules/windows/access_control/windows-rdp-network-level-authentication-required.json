{
  "name": "Windows RDP Network Level Authentication Required",
  "description": "Verifies that Remote Desktop connections require Network Level Authentication (NLA) for added security.",
  "active": true,
  "category": "access_control",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SYSTEM\\CurrentControlSet\\Control\\Terminal Server\\WinStations\\RDP-Tcp\" /v UserAuthentication",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "UserAuthentication\\s+REG_DWORD\\s+0x1"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:NIST_800-53:AC-17",
    "std:NIST_800-53:IA-2",
    "std:ISO27001:A.8.5",
    "std:SOC2:CC6.1",
    "std:CMMC:AC.L2-3.1.12",
    "std:CMMC:IA.L2-3.5.2",
    "std:PCI_DSS_4:2.2.7",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "cat:access_control",
    "env:windows",
    "env:host_level",
    "risk:high"
  ]
}

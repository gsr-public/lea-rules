{
  "uid": "cb0ac7fe-2673-4c81-b823-0c31991c74c8",
  "name": "Windows Logon Legal Notice Text Configured",
  "description": "Ensures a legal notice (LegalNoticeText) is displayed before logon, providing the system-use notification required by many policies.",
  "active": true,
  "category": "access_control",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\" /v LegalNoticeText",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]+LegalNoticeText[ \\t]+REG_(?:EXPAND_)?SZ[ \\t]+\\S"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:NIST_800-53:AC-8",
    "std:ISO27001:A.5.10",
    "std:CMMC:AC.L2-3.1.9",
    "cat:access_control",
    "env:windows",
    "env:host_level",
    "risk:low"
  ]
}

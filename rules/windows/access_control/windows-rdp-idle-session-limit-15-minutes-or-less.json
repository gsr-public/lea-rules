{
  "uid": "2e28a926-58ea-49e2-aa55-2c81abc889b4",
  "name": "Windows RDP Idle Session Limit 15 Minutes or Less",
  "description": "Ensures idle Remote Desktop sessions are disconnected after at most 15 minutes (MaxIdleTime 1-900000 ms).",
  "active": true,
  "category": "access_control",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\Terminal Services\" /v MaxIdleTime",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]+MaxIdleTime[ \\t]+REG_DWORD[ \\t]+0x(?:[1-9a-f]|[1-9a-f][0-9a-f]|[1-9a-f][0-9a-f]{2}|[1-9a-f][0-9a-f]{3}|[1-9a-c][0-9a-f]{4}|d[0-9a][0-9a-f]{3}|db[0-9a][0-9a-f]{2}|dbb[0-9][0-9a-f]|dbba0)\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.3",
    "std:NIST_800-53:AC-11",
    "std:NIST_800-53:AC-12",
    "std:ISO27001:A.8.1",
    "std:SOC2:CC6.1",
    "std:CMMC:AC.L2-3.1.10",
    "std:CMMC:AC.L2-3.1.11",
    "std:PCI_DSS_4:8.2.8",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.312(a)(2)(iii)",
    "std:NIST_CSF_2:PR.AA-03",
    "cat:access_control",
    "env:windows",
    "env:host_level",
    "risk:medium"
  ]
}

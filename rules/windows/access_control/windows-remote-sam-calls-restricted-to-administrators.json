{
  "name": "Windows Remote SAM Calls Restricted to Administrators",
  "description": "Ensures remote calls to the SAM are restricted to administrators (RestrictRemoteSAM = O:BAG:BAD:(A;;RC;;;BA)), blocking account and group enumeration by ordinary domain users (a common BloodHound/SharpHound reconnaissance step).",
  "active": true,
  "category": "access_control",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa\" /v RestrictRemoteSAM",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]+RestrictRemoteSAM[ \\t]+REG_(?:EXPAND_)?SZ[ \\t]+O:BAG:BAD:\\(A;;RC;;;BA\\)[ \\t]*\\r?$"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.7",
    "std:NIST_800-53:AC-2",
    "std:NIST_800-53:AC-3",
    "std:ISO27001:A.5.18",
    "std:SOC2:CC6.2",
    "std:CMMC:AC.L2-3.1.1",
    "std:PCI_DSS_4:2.2.2",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(4)(ii)(C)",
    "std:HIPAA:164.312(a)(1)",
    "std:NIST_CSF_2:PR.AA-01",
    "std:NIST_CSF_2:PR.AA-05",
    "cat:access_control",
    "env:windows",
    "env:host_level",
    "risk:medium"
  ]
}

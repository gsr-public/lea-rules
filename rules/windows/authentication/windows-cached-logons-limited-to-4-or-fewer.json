{
  "uid": "12c94f6c-5744-4318-8f48-4e8354b4a4a3",
  "name": "Windows Cached Logons Limited to 4 or Fewer",
  "description": "Ensures no more than 4 domain logons are cached (CachedLogonsCount), limiting cached credential hashes an attacker can extract and crack offline.",
  "active": true,
  "category": "authentication",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon\" /v CachedLogonsCount",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]+CachedLogonsCount[ \\t]+REG_(?:EXPAND_)?SZ[ \\t]+[0-4][ \\t]*\\r?$"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],

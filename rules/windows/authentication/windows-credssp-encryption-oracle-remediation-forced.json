{
  "name": "Windows CredSSP Encryption Oracle Remediation Forced",
  "description": "Ensures CredSSP only talks to updated clients and servers (AllowEncryptionOracle = 0), mitigating CVE-2018-0886.",
  "active": true,
  "category": "authentication",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {

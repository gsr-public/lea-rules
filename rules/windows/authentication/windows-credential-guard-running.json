{
  "uid": "e633cf3a-80ff-4a20-bb7e-864dd6fa2b1b",
  "name": "Windows Credential Guard Running",
  "description": "Ensures Credential Guard is running (SecurityServicesRunning contains 1), isolating NTLM hashes and Kerberos tickets from LSASS memory so they cannot be dumped with tools such as Mimikatz.",
  "active": true,
  "category": "authentication",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "Get-CimInstance -ClassName Win32_DeviceGuard -Namespace root\\Microsoft\\Windows\\DeviceGuard | Format-List -Property VirtualizationBasedSecurityStatus,SecurityServicesRunning",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^SecurityServicesRunning[ \\t]*:[ \\t]*\\{[^}\\r\\n]*\\b1\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],

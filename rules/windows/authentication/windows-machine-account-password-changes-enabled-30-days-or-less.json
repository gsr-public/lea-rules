{
  "uid": "b54eb03f-ac44-4eed-9e4c-ff02195aff2c",
  "name": "Windows Machine Account Password Changes Enabled (30 Days or Less)",
  "description": "Ensures the computer account password is changed automatically (DisablePasswordChange 0) at least every 30 days (MaximumPasswordAge 1-30).",
  "active": true,
  "category": "authentication",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SYSTEM\\CurrentControlSet\\Services\\Netlogon\\Parameters\"",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]+MaximumPasswordAge[ \\t]+REG_DWORD[ \\t]+0x(?:[1-9a-f]|1[0-9a-e])\\b"
        },
        "not_re": {
          "stdout": "(?mi)^[ \\t]+DisablePasswordChange[ \\t]+REG_DWORD[ \\t]+0x(?!0\\b)"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:5.2",
    "std:NIST_800-53:IA-5",
    "std:ISO27001:A.5.17",

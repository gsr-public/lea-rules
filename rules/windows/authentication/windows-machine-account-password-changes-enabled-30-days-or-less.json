    "std:PCI_DSS_4:8.3.9",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(5)(ii)(D)",
    "std:HIPAA:164.312(d)",
    "std:NIST_CSF_2:PR.AA-01",
    "cat:authentication",
    "env:windows",
    "env:host_level",
    "risk:medium"
  ]

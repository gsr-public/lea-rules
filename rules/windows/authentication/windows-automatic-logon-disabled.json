{
  "uid": "d5645fd8-e830-48c2-a0a6-33ee8818c44e",
  "name": "Windows Automatic Logon Disabled",
  "description": "Ensures Winlogon automatic logon is not enabled (AutoAdminLogon not 1), which would log a stored account in without a password at boot.",
  "active": true,
  "category": "authentication",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon\" /v AutoAdminLogon",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "not_re": {
          "stdout": "(?mi)^[ \\t]+AutoAdminLogon[ \\t]+REG_(?:EXPAND_)?SZ[ \\t]+1[ \\t]*\\r?$"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],

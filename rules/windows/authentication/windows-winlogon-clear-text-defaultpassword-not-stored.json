{
  "name": "Windows Winlogon Clear-Text DefaultPassword Not Stored",
  "description": "Ensures no clear-text password is stored in the Winlogon DefaultPassword registry value, which any administrator or backup operator can read.",
  "active": true,
  "category": "authentication",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon\" /v DefaultPassword",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "not_re": {
          "stdout": "(?mi)^[ \\t]+DefaultPassword[ \\t]+REG_(?:EXPAND_)?SZ[ \\t]+\\S"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:NIST_800-53:IA-5",
    "std:ISO27001:A.5.17",
    "std:SOC2:CC6.1",
    "std:CMMC:IA.L2-3.5.10",
    "std:PCI_DSS_4:8.3.2",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(5)(ii)(D)",
    "std:HIPAA:164.312(d)",
    "std:NIST_CSF_2:PR.AA-01",
    "cat:authentication",
    "env:windows",
    "env:host_level",
    "risk:high"
  ]
}

{
  "name": "Windows Kerberos Encryption Types Exclude DES and RC4",
  "description": "Ensures the Kerberos SupportedEncryptionTypes policy allows only AES (and future) encryption types and excludes DES (0x1, 0x2) and RC4 (0x4), mitigating Kerberoasting with weak RC4 tickets.",
  "active": true,
  "category": "authentication",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\Kerberos\\Parameters\" /v SupportedEncryptionTypes",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]+SupportedEncryptionTypes[ \\t]+REG_DWORD[ \\t]+0x[0-9a-f]*(?:8|[13579bdf]0)\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:NIST_800-53:IA-5",
    "std:NIST_800-53:SC-12",
    "std:NIST_800-53:SC-13",
    "std:ISO27001:A.8.24",
    "std:SOC2:CC6.7",
    "std:CMMC:SC.L2-3.13.11",
    "std:PCI_DSS_4:12.3.3",
    "std:NIS2:Art21.2(h)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(5)(ii)(D)",
    "std:HIPAA:164.312(a)(2)(iv)",
    "std:HIPAA:164.312(d)",
    "std:HIPAA:164.312(e)(2)(ii)",
    "std:NIST_CSF_2:PR.AA-01",
    "std:NIST_CSF_2:PR.DS-01",
    "std:NIST_CSF_2:PR.DS-02",
    "cat:authentication",
    "env:windows",
    "env:host_level",
    "risk:high"
  ]
}

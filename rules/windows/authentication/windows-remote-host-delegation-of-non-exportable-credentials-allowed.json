{
  "uid": "098d7040-747a-4698-b399-9c87ac5c6855",
  "name": "Windows Remote Host Delegation of Non-Exportable Credentials Allowed",
  "description": "Ensures Restricted Admin and Remote Credential Guard can be used (AllowProtectedCreds = 1), so credentials are not exposed on RDP target hosts.",
  "active": true,
  "category": "authentication",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\CredentialsDelegation\" /v AllowProtectedCreds",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]+AllowProtectedCreds[ \\t]+REG_DWORD[ \\t]+0x(?:1)\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },

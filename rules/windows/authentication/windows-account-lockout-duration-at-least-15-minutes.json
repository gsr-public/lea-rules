{
  "name": "Windows Account Lockout Duration At Least 15 Minutes",
  "description": "Ensures locked-out local accounts stay locked for at least 15 minutes (net accounts 'Lockout duration').",
  "active": true,
  "category": "authentication",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "net accounts",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^\\s*Lockout\\s+duration\\s*\\(minutes\\)\\s*:\\s*(?:1[5-9]|[2-9]\\d|[1-9]\\d{2,})\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:NIST_800-53:AC-7",
    "std:ISO27001:A.8.5",
    "std:SOC2:CC6.1",
    "std:CMMC:AC.L2-3.1.8",
    "std:PCI_DSS_4:8.3.4",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(5)(ii)(C)",
    "std:HIPAA:164.312(d)",
    "std:NIST_CSF_2:PR.AA-03",
    "cat:authentication",
    "env:windows",
    "env:host_level",
    "risk:medium"
  ]
}

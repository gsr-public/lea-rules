{
  "uid": "cbff1e3b-879a-4746-8f8c-eec38631c149",
  "name": "Windows Account Lockout Threshold 1-5 Attempts",
  "description": "Ensures local accounts lock after no more than 5 failed logon attempts (net accounts \"Lockout threshold\"); \"Never\" fails.",
  "active": true,
  "category": "authentication",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "net accounts",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^\\s*Lockout\\s+threshold\\s*:\\s*[1-5]\\s*\\r?$"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },

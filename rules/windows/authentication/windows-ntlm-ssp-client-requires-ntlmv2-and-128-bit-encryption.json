  "name": "Windows NTLM SSP Client Requires NTLMv2 and 128-bit Encryption",
  "description": "Ensures NTLM SSP clients require NTLMv2 session security and 128-bit encryption (NTLMMinClientSec = 0x20080000).",
  "active": true,
  "category": "authentication",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa\\MSV1_0\" /v NTLMMinClientSec",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]+NTLMMinClientSec[ \\t]+REG_DWORD[ \\t]+0x(?:20080000)\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },

{
  "name": "Windows Network Credentials Not Stored (DisableDomainCreds)",
  "description": "Ensures Credential Manager does not store passwords and credentials for network authentication (DisableDomainCreds = 1), reducing credentials an attacker can harvest from a compromised session.",
  "active": true,
  "category": "authentication",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa\" /v DisableDomainCreds",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]+DisableDomainCreds[ \\t]+REG_DWORD[ \\t]+0x(?:1)\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },

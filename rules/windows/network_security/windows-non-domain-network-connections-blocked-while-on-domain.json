{
  "uid": "02d43261-9468-4cbe-8702-11c6df425304",
  "name": "Windows Non-Domain Network Connections Blocked While on Domain",
  "description": "Ensures the computer cannot connect simultaneously to the domain network and a non-domain network (fBlockNonDomain = 1), preventing it from bridging networks.",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WcmSvc\\GroupPolicy\" /v fBlockNonDomain",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]+fBlockNonDomain[ \\t]+REG_DWORD[ \\t]+0x(?:1)\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],

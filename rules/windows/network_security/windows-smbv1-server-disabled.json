{
  "name": "Windows SMBv1 Server Disabled",
  "description": "Ensures the SMBv1 server protocol is disabled to prevent exposure of file shares over insecure SMBv1 on Windows.",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query HKLM\\SYSTEM\\CurrentControlSet\\Services\\LanmanServer\\Parameters /v SMB1",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "SMB1\\s+REG_DWORD\\s+0x0"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],

{
  "name": "Windows TLS 1.2 Server Protocol Not Disabled",
  "description": "Ensures TLS 1.2 is not disabled for SCHANNEL server endpoints (no Enabled = 0 and no DisabledByDefault = 1 under the TLS 1.2\\Server key). TLS 1.2 is on by default on supported Windows versions, so a missing key passes. A working TLS 1.2+ baseline is the foundation for later hybrid post-quantum deployments.",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\SCHANNEL\\Protocols\\TLS 1.2\\Server\"",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "not_re": {
          "stdout": "\\bEnabled\\s+REG_DWORD\\s+0x0\\b"
        }
      },
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "not_re": {
          "stdout": "\\bDisabledByDefault\\s+REG_DWORD\\s+0x1\\b"
        }
      }
    ],
    "remedy": [],
    "system": []
  },

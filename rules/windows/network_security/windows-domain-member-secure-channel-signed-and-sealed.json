{
  "uid": "f640a3ac-0187-451d-8b98-a2f7f8c282e1",
  "name": "Windows Domain Member Secure Channel Signed and Sealed",
  "description": "Ensures the domain member always signs and encrypts secure channel traffic (RequireSignOrSeal, SealSecureChannel and SignSecureChannel all 1) and requires a strong session key (RequireStrongKey 1).",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SYSTEM\\CurrentControlSet\\Services\\Netlogon\\Parameters\"",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]+RequireSignOrSeal[ \\t]+REG_DWORD[ \\t]+0x1\\b"
        }
      },
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]+SealSecureChannel[ \\t]+REG_DWORD[ \\t]+0x1\\b"
        }
      },
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]+SignSecureChannel[ \\t]+REG_DWORD[ \\t]+0x1\\b"
        }
      },
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]+RequireStrongKey[ \\t]+REG_DWORD[ \\t]+0x1\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],

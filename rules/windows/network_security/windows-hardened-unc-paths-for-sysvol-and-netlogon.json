{
  "name": "Windows Hardened UNC Paths for SYSVOL and NETLOGON",
  "description": "Ensures UNC hardening requires mutual authentication and integrity for \\\\*\\SYSVOL and \\\\*\\NETLOGON, protecting Group Policy and logon scripts against man-in-the-middle attacks (MS15-011).",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\NetworkProvider\\HardenedPaths\"",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]+\\\\\\\\\\*\\\\NETLOGON[ \\t]+REG_SZ[ \\t]+(?=[^\\r\\n]*RequireMutualAuthentication=1)(?=[^\\r\\n]*RequireIntegrity=1)"
        }
      },
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]+\\\\\\\\\\*\\\\SYSVOL[ \\t]+REG_SZ[ \\t]+(?=[^\\r\\n]*RequireMutualAuthentication=1)(?=[^\\r\\n]*RequireIntegrity=1)"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:3.10",
    "std:NIST_800-53:SC-8",
    "std:NIST_800-53:SC-23",
    "std:NIST_800-53:SI-7",
    "std:ISO27001:A.8.21",
    "std:ISO27001:A.8.24",
    "std:SOC2:CC6.7",
    "std:CMMC:SC.L2-3.13.8",
    "std:CMMC:SC.L2-3.13.15",
    "std:PCI_DSS_4:4.2.1",
    "std:NIS2:Art21.2(h)",
    "std:DORA:Art9",
    "std:HIPAA:164.312(c)(1)",
    "std:HIPAA:164.312(e)(1)",
    "std:HIPAA:164.312(e)(2)(ii)",
    "std:NIST_CSF_2:DE.CM-09",
    "std:NIST_CSF_2:PR.DS-01",
    "std:NIST_CSF_2:PR.DS-02",
    "cat:network_security",
    "env:windows",
    "env:host_level",
    "risk:high"
  ]
}

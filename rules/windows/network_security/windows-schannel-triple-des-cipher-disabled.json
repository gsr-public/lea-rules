{
  "name": "Windows SChannel Triple-DES Cipher Disabled",
  "description": "Ensures the Triple DES 168 cipher is explicitly disabled in SCHANNEL (Enabled = 0). 3DES has a 64-bit block size (Sweet32) and is not enabled-by-absence safe on older Windows versions.",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\SCHANNEL\\Ciphers\\Triple DES 168\" /v Enabled",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "Enabled\\s+REG_DWORD\\s+0x0\\b"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],

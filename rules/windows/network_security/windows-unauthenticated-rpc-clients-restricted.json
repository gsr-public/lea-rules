{
  "name": "Windows Unauthenticated RPC Clients Restricted",
  "description": "Ensures the RPC runtime rejects unauthenticated RPC clients (RestrictRemoteClients = 1). Intended for workstations; some server roles require exemptions.",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\Rpc\" /v RestrictRemoteClients",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]+RestrictRemoteClients[ \\t]+REG_DWORD[ \\t]+0x(?:1|2)\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:NIST_800-53:IA-2",
    "std:ISO27001:A.8.5",
    "std:SOC2:CC6.1",
    "std:CMMC:IA.L2-3.5.2",
    "std:PCI_DSS_4:8.3.1",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.312(a)(2)(i)",
    "std:HIPAA:164.312(d)",
    "std:NIST_CSF_2:PR.AA-03",
    "cat:network_security",
    "env:windows",
    "env:host_level",
    "risk:low"
  ]
}

{
  "uid": "4463c78c-ec4f-4e7d-9dd4-04c2beb834f5",
  "name": "Windows SMB Server Disconnects Clients When Logon Hours Expire",
  "description": "Ensures SMB sessions are disconnected when logon hours expire (enableforcedlogoff = 1).",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SYSTEM\\CurrentControlSet\\Services\\LanmanServer\\Parameters\" /v enableforcedlogoff",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]+enableforcedlogoff[ \\t]+REG_DWORD[ \\t]+0x(?:1)\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],

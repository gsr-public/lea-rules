{
  "name": "Windows TLS 1.0 Server Protocol Disabled",
  "description": "Ensures TLS 1.0 is explicitly disabled for SCHANNEL server endpoints (Enabled = 0). Older Windows versions enable TLS 1.0 when the key is absent, so an explicit setting is required.",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\SCHANNEL\\Protocols\\TLS 1.0\\Server\" /v Enabled",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "Enabled\\s+REG_DWORD\\s+0x0\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],

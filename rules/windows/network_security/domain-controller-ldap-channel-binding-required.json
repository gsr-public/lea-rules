{
  "name": "Domain Controller LDAP Channel Binding Required",
  "description": "Ensures the domain controller always requires LDAPS channel binding tokens (LdapEnforceChannelBinding = 2). Passes with LEA_RULE_no_service on hosts that are not domain controllers.",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "if (Test-Path 'HKLM:\\SYSTEM\\CurrentControlSet\\Services\\NTDS\\Parameters') { reg query \"HKLM\\SYSTEM\\CurrentControlSet\\Services\\NTDS\\Parameters\" /v LdapEnforceChannelBinding } else { 'LEA_RULE_no_service' }",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]+LdapEnforceChannelBinding[ \\t]+REG_DWORD[ \\t]+0x2\\b|LEA_RULE_no_service"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:3.10",
    "std:NIST_800-53:SC-8",
    "std:NIST_800-53:SC-23",
    "std:ISO27001:A.8.21",
    "std:ISO27001:A.8.24",
    "std:SOC2:CC6.7",
    "std:CMMC:SC.L2-3.13.8",
    "std:CMMC:SC.L2-3.13.15",
    "std:PCI_DSS_4:4.2.1",
    "std:NIS2:Art21.2(h)",
    "std:DORA:Art9",
    "std:HIPAA:164.312(e)(1)",
    "std:HIPAA:164.312(e)(2)(ii)",
    "std:NIST_CSF_2:PR.DS-02",
    "cat:network_security",
    "env:windows",
    "env:host_level",
    "risk:high"
  ]
}

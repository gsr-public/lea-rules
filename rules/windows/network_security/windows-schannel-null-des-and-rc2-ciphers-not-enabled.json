{
  "name": "Windows SChannel NULL, DES and RC2 Ciphers Not Enabled",
  "description": "Ensures no NULL, DES or RC2 cipher is explicitly enabled in the SCHANNEL configuration. A missing key passes; an Enabled value other than 0 under any of these cipher keys fails.",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\SCHANNEL\\Ciphers\" /s",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "not_re": {
          "stdout": "Ciphers\\\\(?:NULL|DES [^\\r\\n]*|RC2 [^\\r\\n]*)\\r?\\n(?:[ \\t]+[^\\r\\n]*\\r?\\n)*?[ \\t]+Enabled[ \\t]+REG_DWORD[ \\t]+0x(?!0\\b)[0-9a-f]+"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],

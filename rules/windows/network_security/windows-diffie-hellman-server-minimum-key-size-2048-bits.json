{
  "name": "Windows Diffie-Hellman Server Minimum Key Size 2048 Bits",
  "description": "Ensures SCHANNEL servers refuse Diffie-Hellman groups smaller than 2048 bits (ServerMinKeyBitLength >= 0x800), mitigating Logjam-style downgrade attacks.",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query HKLM\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\SCHANNEL\\KeyExchangeAlgorithms\\Diffie-Hellman /v ServerMinKeyBitLength",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "ServerMinKeyBitLength\\s+REG_DWORD\\s+0x(?:[89a-f][0-9a-f]{2}|[1-9a-f][0-9a-f]{3,})\\b"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:NIST_800-53:SC-12",
    "std:NIST_800-53:SC-13",
    "std:ISO27001:A.8.24",
    "std:SOC2:CC6.7",
    "std:CMMC:SC.L2-3.13.11",
    "std:PCI_DSS_4:12.3.3",
    "std:NIS2:Art21.2(h)",
    "std:DORA:Art9",
    "std:HIPAA:164.312(a)(2)(iv)",
    "std:HIPAA:164.312(e)(2)(ii)",
    "std:NIST_CSF_2:PR.DS-01",
    "std:NIST_CSF_2:PR.DS-02",
    "std:NIST_PQC:transition",
    "cat:network_security",
    "env:windows",
    "env:host_level",
    "risk:medium"
  ]
}

{
  "name": "Windows SMB Server Signing Required",
  "description": "Ensures the SMB server always requires packet signing (RequireSecuritySignature = 1), preventing SMB relay and man-in-the-middle tampering.",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query HKLM\\SYSTEM\\CurrentControlSet\\Services\\LanmanServer\\Parameters /v RequireSecuritySignature",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "RequireSecuritySignature\\s+REG_DWORD\\s+0x1\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },

{
  "name": "Windows Defender Tamper Protection Enabled",
  "description": "Ensures Microsoft Defender tamper protection is on (Get-MpComputerStatus IsTamperProtected = True), preventing malware or local administrators from silently turning protection off.",
  "active": true,
  "category": "integrity",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "Get-MpComputerStatus | Format-List -Property IsTamperProtected",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^IsTamperProtected\\s*:\\s*True\\b"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],

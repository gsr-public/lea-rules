{
  "name": "Windows Defender SmartScreen Enabled",
  "description": "Ensures Windows Defender SmartScreen is enabled by policy, warning before unrecognized or known-malicious downloaded programs run.",
  "active": true,
  "category": "integrity",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\System /v EnableSmartScreen",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "EnableSmartScreen\\s+REG_DWORD\\s+0x1\\b"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],

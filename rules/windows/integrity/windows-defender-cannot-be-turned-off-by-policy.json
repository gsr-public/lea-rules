{
  "name": "Windows Defender Cannot Be Turned Off by Policy",
  "description": "Ensures no policy turns off Microsoft Defender Antivirus (DisableAntiSpyware not 1 under the Windows Defender policy key). An absent value passes.",
  "active": true,
  "category": "integrity",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "reg query \"HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows Defender\" /v DisableAntiSpyware",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Windows"
        ],
        "distribution": [],

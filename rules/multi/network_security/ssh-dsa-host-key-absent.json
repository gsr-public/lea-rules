{
  "uid": "c9d71604-a602-4545-b3ea-7a2ee68cc9fc",
  "name": "SSH DSA Host Key Absent",
  "description": "Ensures no DSA (ssh-dss) host key exists in /etc/ssh. DSA is limited to 1024-bit keys and SHA-1, and was removed from OpenSSH 10.",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "ls /etc/ssh",
        "system": [
          "Linux"
        ],
        "distribution": []
      },
      {
        "command": "ls /etc/ssh",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\S"
        },
        "not_re": {
          "stdout": "\\bssh_host_dsa_key\\b"
        }
      },
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\S"
        },
        "not_re": {
          "stdout": "\\bssh_host_dsa_key\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },

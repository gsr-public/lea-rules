{
  "uid": "358ebefb-28b5-4a37-a2c4-8d4e209a4900",
  "name": "Automatic Security Updates Enabled",
  "former_names": [
    "Automatic Updates Enabled",
    "CIS - Automatic Updates Enabled"
  ],
  "description": "Verifies that automatic operating system updates are enabled on Linux and Windows hosts to reduce exposure to known vulnerabilities.",
  "active": true,
  "category": "system_hardening",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/apt/apt.conf.d/20auto-upgrades /etc/dnf/automatic.conf 2>/dev/null",
        "system": [
          "Linux"
        ],
        "distribution": []
      },
      {
        "command": "(Get-ItemProperty -Path 'HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU' -Name NoAutoUpdate -ErrorAction SilentlyContinue).NoAutoUpdate",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^[ \\t]*(?:APT::Periodic::Unattended-Upgrade[ \\t]+\"1\"|apply_updates[ \\t]*=[ \\t]*yes\\b)"
        }
      },
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\A\\s*0?\\s*\\Z"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:7.3",
    "std:NIST_800-53:SI-2",
    "std:ISO27001:A.8.8",
    "std:ISO27001:A.12.6.1",
    "std:SOC2:CC7.1",
    "std:CMMC:SI.L2-3.14.1",
    "std:PCI_DSS_4:6.3.3",
    "std:NIS2:Art21.2(e)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(1)(ii)(B)",
    "std:NIST_CSF_2:ID.RA-01",
    "std:NIST_CSF_2:PR.PS-02",
    "cat:system_hardening",
    "env:linux",
    "env:windows",
    "env:host_level",
    "risk:high"
  ]
}

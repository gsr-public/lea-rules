  "name": "Root Filesystem Usage Below 85%",
  "former_names": [
    "Disk Capacity Threshold"
  ],
  "description": "Ensures the root filesystem usage remains below 85 percent on Linux and macOS hosts to avoid capacity-related failures.",
  "active": true,
  "category": "system_hardening",
  "cycle": 43200,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "df -P /",
        "system": [
          "Linux"
        ],
        "distribution": []
      },
      {
        "command": "df -P /",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^\\S+\\s+\\d+\\s+\\d+\\s+\\d+\\s+(?:\\d|[0-7]\\d|8[0-4])%\\s+/\\s*$"
        }
      },
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^\\S+\\s+\\d+\\s+\\d+\\s+\\d+\\s+(?:\\d|[0-7]\\d|8[0-4])%\\s+/\\s*$"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },

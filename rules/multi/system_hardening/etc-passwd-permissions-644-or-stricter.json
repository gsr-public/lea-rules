{
  "name": "/etc/passwd Permissions 644 or Stricter",
  "description": "Verifies that the account database /etc/passwd is owned by root (group root on Linux, wheel on macOS) and is not writable by group or others (mode 644 or stricter). stat reads metadata only, so no privileges are needed.",
  "active": true,
  "category": "system_hardening",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "stat -c '%a %U %G' /etc/passwd",
        "system": [
          "Linux"
        ],
        "distribution": []
      },
      {
        "command": "stat -f '%Lp %Su %Sg' /etc/passwd",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\A[46][04][04] root root\\s*\\Z"
        }
      },
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\A[46][04][04] root wheel\\s*\\Z"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:3.3",
    "std:NIST_800-53:AC-3",
    "std:ISO27001:A.8.3",
    "std:SOC2:CC6.1",
    "std:CMMC:AC.L2-3.1.1",
    "std:PCI_DSS_4:2.2.6",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "cat:system_hardening",
    "env:linux",
    "env:macos",
    "env:host_level",
    "risk:medium"
  ]
}

{
  "name": "Password Maximum Age 90 Days or Less",
  "description": "Ensures passwords expire within an acceptable maximum age (e.g., 90 days or less).",
  "active": true,
  "category": "password_policy",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/login.defs",
        "system": [
          "Linux"
        ],
        "distribution": []
      },
      {
        "command": "net accounts",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^\\s*(?!#)PASS_MAX_DAYS\\s+([1-9]|[1-8]\\d|90)\\b"
        }
      },
      {
        "system": [
          "Windows"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^\\s*Maximum\\s+password\\s+age\\s*\\(days\\)\\s*:\\s*(?:[1-9]|[1-8]\\d|90)\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:5.2",
    "std:NIST_800-53:IA-5",
    "std:ISO27001:A.5.17",
    "std:ISO27001:A.9.4.3",
    "std:SOC2:CC6.1",
    "std:PCI_DSS_4:8.3.9",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(5)(ii)(D)",
    "std:HIPAA:164.312(d)",
    "std:NIST_CSF_2:PR.AA-01",
    "cat:password_policy",
    "env:linux",
    "env:windows",
    "env:host_level",
    "risk:medium"
  ]
}

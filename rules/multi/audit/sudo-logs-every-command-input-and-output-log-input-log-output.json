{
  "name": "Sudo Logs Every Command Input and Output (log_input/log_output)",
  "description": "Ensures sudoers enables I/O logging (Defaults log_output or log_input), recording the full session of privileged commands for forensic review.\nRequired sudo rule: allow user lea to run ONLY this exact command without a password: lea ALL=(root) NOPASSWD: /bin/cat /etc/sudoers /etc/sudoers.d/*",
  "active": true,
  "category": "audit",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/sudoers /etc/sudoers.d/* 2>/dev/null",
        "system": [
          "Linux"
        ],
        "distribution": []
      },
      {
        "command": "cat /etc/sudoers /private/etc/sudoers.d/* 2>/dev/null",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]*Defaults\\b[^\\n]*(?<!!)\\blog_(?:output|input)\\b"
        }
      },
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]*Defaults\\b[^\\n]*(?<!!)\\blog_(?:output|input)\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:8.2",
    "std:CIS_Controls_v8:8.5",
    "std:CIS_Controls_v8:8.8",
    "std:NIST_800-53:AC-6",
    "std:NIST_800-53:AU-2",
    "std:NIST_800-53:AU-12",
    "std:ISO27001:A.8.15",
    "std:SOC2:CC7.2",
    "std:CMMC:AU.L2-3.3.1",
    "std:CMMC:AU.L2-3.3.2",
    "std:PCI_DSS_4:10.2.1",
    "std:PCI_DSS_4:10.2.2",
    "std:NIS2:Art21.2(b)",
    "std:DORA:Art10",
    "std:HIPAA:164.312(a)(1)",
    "std:HIPAA:164.312(b)",
    "std:NIST_CSF_2:PR.AA-05",
    "std:NIST_CSF_2:PR.PS-04",
    "cat:audit",
    "env:linux",
    "env:macos",
    "env:host_level",
    "risk:low",
    "priv:required"
  ]
}

{
  "uid": "70764718-30d1-42e6-986a-d153667b5e93",
  "name": "SSH Maximum Authentication Attempts 4 or Fewer",
  "description": "Ensures MaxAuthTries is set between 1 and 4 and no sshd configuration file sets a higher value, limiting password and key guessing per connection.\nPrivilege: reads /etc/ssh/sshd_config and its drop-in directory. Debian and Ubuntu ship these files world-readable; RHEL-family systems ship sshd_config as mode 0600, so the agent needs read access to it there (an unreadable file fails the check instead of passing). On Linux the rule passes with LEA_RULE_no_service when no sshd process is running.",
  "active": true,
  "category": "authentication",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "if cat /proc/*/comm 2>/dev/null | grep -q '^sshd$'; then cat /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf 2>/dev/null; else echo 'LEA_RULE_no_service'; fi",
        "system": [
          "Linux"
        ],
        "distribution": []
      },
      {
        "command": "cat /etc/ssh/sshd_config /etc/ssh/sshd_config.d/* 2>/dev/null",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]*MaxAuthTries[ \\t]+[1-4]\\b|LEA_RULE_no_service"
        },
        "not_re": {
          "stdout": "(?mi)^[ \\t]*MaxAuthTries[ \\t]+(?:0|[5-9]|[1-9]\\d+)\\b"
        }
      },
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?mi)^[ \\t]*MaxAuthTries[ \\t]+[1-4]\\b|LEA_RULE_no_service"
        },
        "not_re": {
          "stdout": "(?mi)^[ \\t]*MaxAuthTries[ \\t]+(?:0|[5-9]|[1-9]\\d+)\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:NIST_800-53:AC-7",
    "std:NIST_800-53:AC-17",
    "std:ISO27001:A.8.5",
    "std:SOC2:CC6.1",
    "std:CMMC:AC.L2-3.1.8",
    "std:CMMC:AC.L2-3.1.12",
    "std:PCI_DSS_4:2.2.7",
    "std:PCI_DSS_4:8.3.4",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(5)(ii)(C)",
    "std:HIPAA:164.312(a)(1)",
    "std:HIPAA:164.312(d)",
    "std:HIPAA:164.312(e)(1)",
    "std:NIST_CSF_2:PR.AA-03",
    "std:NIST_CSF_2:PR.AA-05",
    "std:NIST_CSF_2:PR.IR-01",
    "cat:authentication",
    "env:linux",
    "env:macos",
    "env:host_level",
    "risk:medium"
  ]
}

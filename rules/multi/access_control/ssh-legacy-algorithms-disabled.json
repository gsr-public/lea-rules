{
  "name": "SSH Legacy Algorithms Disabled",
  "description": "Ensures legacy and quantum-weak SSH algorithms (ssh-rsa with SHA-1 signatures, ssh-dss, and SHA-1 based Diffie-Hellman key exchanges) are not explicitly enabled on any active line of the SSH daemon configuration.\nPrivilege: reads /etc/ssh/sshd_config and its drop-in directory. Debian and Ubuntu ship these files world-readable; RHEL-family systems ship sshd_config as mode 0600, so the agent needs read access to it there (an unreadable file fails the check instead of passing). On Linux the rule passes with LEA_RULE_no_service when no sshd process is running.",
  "active": true,
  "category": "access_control",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "if cat /proc/*/comm 2>/dev/null | grep -q '^sshd$'; then cat /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf 2>/dev/null; else echo 'LEA_RULE_no_service'; fi",
        "system": [
          "Linux"
        ],
        "distribution": []
      },
      {
        "command": "cat /etc/ssh/sshd_config /etc/ssh/sshd_config.d/* 2>/dev/null",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\S"
        },
        "not_re": {
          "stdout": "(?mi)^[ \\t]*[^#\\s][^\\n]*\\b(?:ssh-rsa|ssh-dss|diffie-hellman-group1-sha1|diffie-hellman-group14-sha1|diffie-hellman-group-exchange-sha1)\\b"
        }
      },
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\S"
        },
        "not_re": {
          "stdout": "(?mi)^[ \\t]*[^#\\s][^\\n]*\\b(?:ssh-rsa|ssh-dss|diffie-hellman-group1-sha1|diffie-hellman-group14-sha1|diffie-hellman-group-exchange-sha1)\\b"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:3.10",
    "std:NIST_800-53:AC-17",
    "std:NIST_800-53:SC-8",
    "std:NIST_800-53:SC-13",
    "std:ISO27001:A.8.24",
    "std:SOC2:CC6.7",
    "std:CMMC:AC.L2-3.1.12",
    "std:CMMC:SC.L2-3.13.8",
    "std:CMMC:SC.L2-3.13.11",
    "std:PCI_DSS_4:2.2.7",
    "std:PCI_DSS_4:4.2.1",
    "std:NIS2:Art21.2(h)",
    "std:DORA:Art9",
    "std:HIPAA:164.312(a)(1)",
    "std:HIPAA:164.312(a)(2)(iv)",
    "std:HIPAA:164.312(e)(1)",
    "std:HIPAA:164.312(e)(2)(ii)",
    "std:NIST_CSF_2:PR.AA-05",
    "std:NIST_CSF_2:PR.DS-01",
    "std:NIST_CSF_2:PR.DS-02",
    "std:NIST_CSF_2:PR.IR-01",
    "std:NIST_PQC:transition",
    "std:NCSC:PQC_readiness",
    "std:BIS:QuantumRoadmap",
    "cat:access_control",
    "env:linux",
    "env:macos",
    "env:host_level",
    "risk:high"
  ]
}

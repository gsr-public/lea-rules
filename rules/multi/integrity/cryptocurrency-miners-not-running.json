{
  "uid": "21343e30-540d-4dc4-ae30-3d43b9e4bab4",
  "name": "Cryptocurrency Miners Not Running",
  "description": "Ensures no known cryptocurrency mining software or cryptojacking malware is running (XMRig, cpuminer, ethminer, T-Rex, NBMiner, lolMiner, PhoenixMiner, TeamRedMiner, SRBMiner, Kinsing and kdevtmpfsi, among others). Process names are read from /proc/*/comm on Linux, ps -axco command on macOS and tasklist on Windows.",
  "active": true,
  "category": "integrity",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /proc/*/comm",
        "system": [
          "Linux"
        ],
        "distribution": []
      },
      {
        "command": "ps -axco command",
        "system": [
          "Darwin"
        ],
        "distribution": []
      },
      {
        "command": "tasklist",
        "system": [
          "Windows"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Linux"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\S"
        },
        "not_re": {
          "stdout": "(?mi)(?:^|[\\\\/ ])(?:xmrig|minerd|cpuminer|ethminer|t\\-rex|nbminer|lolminer|phoenixminer|kdevtmpfsi|kinsing|xmr\\-stak|nanominer|gminer|teamredminer|srbminer)(?:\\.exe)?\\b"
        }
      },

{
  "uid": "c2dbca87-b912-4801-a11f-012e8a29be96",
  "name": "macOS Secure Boot Full Security",
  "description": "Ensures the Mac boots with Full Security (SecureBootLevel = full), so only the current signed operating system can start. Intel Macs without a T2 chip report no secure boot level and fail.\nRequired sudo rule: allow user lea to run ONLY this exact command without a password: lea ALL=(root) NOPASSWD: /usr/libexec/mdmclient QuerySecurityInfo",
  "active": true,
  "category": "kernel_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "/usr/libexec/mdmclient QuerySecurityInfo",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "SecureBootLevel[ \\t]*=[ \\t]*\"?full\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.1",
    "std:NIST_800-53:CM-6",
    "std:NIST_800-53:SI-7",
    "std:ISO27001:A.8.9",
    "std:SOC2:CC7.1",
    "std:CMMC:CM.L2-3.4.2",
    "std:PCI_DSS_4:2.2.6",
    "std:NIS2:Art21.2(e)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(1)(ii)(B)",
    "std:HIPAA:164.312(c)(1)",
    "std:NIST_CSF_2:DE.CM-09",
    "std:NIST_CSF_2:PR.DS-01",
    "std:NIST_CSF_2:PR.PS-01",
    "cat:kernel_security",
    "env:macos",
    "env:host_level",
    "risk:high",
    "priv:required"
  ]
}

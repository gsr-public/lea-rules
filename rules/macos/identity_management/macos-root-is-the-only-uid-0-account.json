{
  "name": "macOS Root Is the Only UID 0 Account",
  "description": "Ensures no local account other than root has UID 0.",
  "active": true,
  "category": "identity_management",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "dscl . -list /Users UniqueID",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^root[ \\t]+0[ \\t]*$"
        },
        "not_re": {
          "stdout": "(?m)^(?!root[ \\t])\\S+[ \\t]+0[ \\t]*$"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],

{
  "uid": "f27dd5b5-1032-41fd-9862-65931b4a684a",
  "name": "macOS Guest Account Disabled (Effective Policy)",
  "description": "Ensures the guest account is disabled in the effective login window policy (GuestEnabled = false), including MDM profiles. Reads the effective value of GuestEnabled in the com.apple.loginwindow domain (including settings delivered by an MDM configuration profile) through NSUserDefaults; an unset value fails.",
  "active": true,
  "category": "identity_management",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "/usr/bin/osascript -l JavaScript -e '$.NSUserDefaults.alloc.initWithSuiteName(\"com.apple.loginwindow\").objectForKey(\"GuestEnabled\").js'",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\A\\s*(?:false|0)\\s*\\Z"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.7",
    "std:NIST_800-53:AC-2",
    "std:ISO27001:A.5.18",
    "std:SOC2:CC6.2",
    "std:CMMC:AC.L2-3.1.1",
    "std:PCI_DSS_4:2.2.2",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(4)(ii)(C)",
    "std:HIPAA:164.312(a)(1)",
    "std:NIST_CSF_2:PR.AA-01",
    "std:NIST_CSF_2:PR.AA-05",
    "cat:identity_management",
    "env:macos",
    "env:host_level",
    "risk:medium"
  ]
}

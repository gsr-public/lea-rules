{
  "uid": "c65042b8-f84d-48a6-b91c-40cc4fb45868",
  "name": "macOS Login Window Banner Configured",
  "description": "Ensures the login window displays a policy banner (LoginwindowText is set). Reads the effective value of LoginwindowText in the com.apple.loginwindow domain (including settings delivered by an MDM configuration profile) through NSUserDefaults; an unset value fails.",
  "active": true,
  "category": "access_control",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "/usr/bin/osascript -l JavaScript -e '$.NSUserDefaults.alloc.initWithSuiteName(\"com.apple.loginwindow\").objectForKey(\"LoginwindowText\").js'",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\A\\s*(?:(?!undefined\\s*\\Z)[^\\n]*[A-Za-z]{3,}[^\\n]*)\\s*\\Z"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:NIST_800-53:AC-8",
    "std:ISO27001:A.5.10",
    "std:CMMC:AC.L2-3.1.9",
    "cat:access_control",
    "env:macos",
    "env:host_level",
    "risk:low"
  ]
}

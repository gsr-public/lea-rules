{
  "uid": "85609bac-345e-49de-aed7-23ac10c4a3b8",
  "name": "macOS Screen Saver Starts Within 20 Minutes",
  "description": "Ensures the screen saver starts after at most 1200 seconds of inactivity (idleTime 1-1200). Reads the effective value of idleTime in the com.apple.screensaver domain (including settings delivered by an MDM configuration profile) through NSUserDefaults; an unset value fails.",
  "active": true,
  "category": "access_control",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "/usr/bin/osascript -l JavaScript -e '$.NSUserDefaults.alloc.initWithSuiteName(\"com.apple.screensaver\").objectForKey(\"idleTime\").js'",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\A\\s*(?:(?:[1-9]|[1-9]\\d|[1-9]\\d{2}|1[01]\\d{2}|1200))\\s*\\Z"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.3",
    "std:NIST_800-53:AC-11",
    "std:NIST_800-53:AC-12",
    "std:ISO27001:A.8.1",
    "std:SOC2:CC6.1",
    "std:CMMC:AC.L2-3.1.10",
    "std:CMMC:AC.L2-3.1.11",
    "std:PCI_DSS_4:8.2.8",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.312(a)(2)(iii)",
    "std:NIST_CSF_2:PR.AA-03",
    "cat:access_control",
    "env:macos",
    "env:host_level",
    "risk:medium"
  ]
}

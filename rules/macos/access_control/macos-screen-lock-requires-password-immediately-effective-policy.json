{
  "name": "macOS Screen Lock Requires Password Immediately (Effective Policy)",
  "description": "Ensures a password is required immediately when the screen saver starts or the display sleeps (askForPasswordDelay 0-5 seconds), including MDM profiles. Reads the effective value of askForPasswordDelay in the com.apple.screensaver domain (including settings delivered by an MDM configuration profile) through NSUserDefaults; an unset value fails.",
  "active": true,
  "category": "access_control",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "/usr/bin/osascript -l JavaScript -e '$.NSUserDefaults.alloc.initWithSuiteName(\"com.apple.screensaver\").objectForKey(\"askForPasswordDelay\").js'",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\A\\s*(?:[0-5])\\s*\\Z"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.3",
    "std:NIST_800-53:AC-11",
    "std:NIST_800-53:AC-12",
    "std:ISO27001:A.8.1",
    "std:SOC2:CC6.1",
    "std:CMMC:AC.L2-3.1.10",
    "std:CMMC:AC.L2-3.1.11",
    "std:PCI_DSS_4:8.2.8",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.312(a)(2)(iii)",
    "std:NIST_CSF_2:PR.AA-03",
    "cat:access_control",
    "env:macos",
    "env:host_level",
    "risk:medium"
  ]
}

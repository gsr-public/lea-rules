{
  "uid": "bfc9266c-edcb-4e4d-9302-cda91e316552",
  "name": "macOS SMB Guest Access Disabled",
  "description": "Ensures the SMB server does not allow guest access to shared folders (AllowGuestAccess not 1).",
  "active": true,
  "category": "access_control",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "defaults read /Library/Preferences/SystemConfiguration/com.apple.smb.server AllowGuestAccess 2>&1",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\S"
        },
        "not_re": {
          "stdout": "\\A\\s*1\\s*\\Z"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },

{
  "uid": "411f6c84-94a1-48e6-919a-a4c6bfcfb0b3",
  "name": "macOS Sudo Timestamp Separated per Terminal",
  "description": "Ensures sudoers does not switch the sudo authentication timestamp to global or per-parent-process records (timestamp_type=global/ppid or !tty_tickets), so one authenticated terminal does not elevate another. The macOS default is per terminal.\nRequired sudo rule: allow user lea to run ONLY this exact command without a password: lea ALL=(root) NOPASSWD: /bin/cat /etc/sudoers /private/etc/sudoers.d/*",
  "active": true,
  "category": "access_control",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cat /etc/sudoers /private/etc/sudoers.d/* 2>/dev/null",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\S"
        },
        "not_re": {
          "stdout": "(?mi)^[ \\t]*Defaults\\b[^\\n]*(?:\\btimestamp_type[ \\t]*=[ \\t]*(?:global|ppid|kernel)\\b|!tty_tickets\\b)"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:5.4",
    "std:NIST_800-53:AC-6",
    "std:ISO27001:A.8.2",
    "std:SOC2:CC6.3",
    "std:CMMC:AC.L2-3.1.5",
    "std:CMMC:AC.L2-3.1.7",
    "std:PCI_DSS_4:7.2.2",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.312(a)(1)",
    "std:NIST_CSF_2:PR.AA-05",
    "cat:access_control",
    "env:macos",
    "env:host_level",
    "risk:low",
    "priv:required"
  ]
}

{
  "name": "macOS System-Wide Applications Not World-Writable",
  "description": "Ensures no application bundle in /Applications is world-writable, so other users cannot replace application code that administrators run.",
  "active": true,
  "category": "access_control",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "find /Applications -maxdepth 1 -perm -2",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "not_re": {
          "stdout": "."
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:3.3",
    "std:NIST_800-53:AC-3",
    "std:ISO27001:A.8.3",
    "std:SOC2:CC6.1",
    "std:CMMC:AC.L2-3.1.1",
    "std:PCI_DSS_4:2.2.6",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.312(a)(1)",
    "std:NIST_CSF_2:PR.AA-05",
    "cat:access_control",
    "env:macos",
    "env:host_level",
    "risk:medium"
  ]
}

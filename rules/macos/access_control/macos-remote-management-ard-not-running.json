    "std:ISO27001:A.8.5",
    "std:ISO27001:A.8.20",
    "std:SOC2:CC6.1",
    "std:SOC2:CC6.6",
    "std:CMMC:AC.L2-3.1.12",
    "std:PCI_DSS_4:2.2.7",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(1)(ii)(B)",
    "std:HIPAA:164.312(a)(1)",
    "std:HIPAA:164.312(e)(1)",
    "std:NIST_CSF_2:PR.AA-05",

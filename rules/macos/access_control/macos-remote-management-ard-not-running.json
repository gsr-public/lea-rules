{
  "name": "macOS Remote Management (ARD) Not Running",
  "description": "Ensures the Apple Remote Desktop agent (ARDAgent) is not running, so the Mac cannot be remotely controlled through Remote Management. Process names are read with ps -axco command.",
  "active": true,
  "category": "access_control",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "ps -axco command",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\S"
        },
        "not_re": {
          "stdout": "(?m)^ARDAgent$"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],

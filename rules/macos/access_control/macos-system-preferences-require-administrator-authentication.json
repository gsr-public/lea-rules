{
  "uid": "773b9f88-82f6-4168-8f0c-04165dcc6d0d",
  "name": "macOS System Preferences Require Administrator Authentication",
  "description": "Ensures system-wide settings panes cannot be unlocked by standard users (authorization right system.preferences has shared = false).",
  "active": true,
  "category": "access_control",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "security authorizationdb read system.preferences 2>/dev/null",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "<key>shared</key>\\s*<false/>"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",

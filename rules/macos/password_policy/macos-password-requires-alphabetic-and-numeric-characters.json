{
  "name": "macOS Password Requires Alphabetic and Numeric Characters",
  "description": "Ensures the local account policy requires both letters and digits (policy content matching [A-Za-z] and [0-9]). Read from pwpolicy getaccountpolicies (global policy, including policies installed by an MDM profile).",
  "active": true,
  "category": "password_policy",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "pwpolicy getaccountpolicies",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "policyAttributePassword matches '[^'\\n]*\\[(?:A-Za-z|a-zA-Z|a-z|A-Z)\\][\\s\\S]*policyAttributePassword matches '[^'\\n]*\\[0-9\\]|policyAttributePassword matches '[^'\\n]*\\[0-9\\][\\s\\S]*policyAttributePassword matches '[^'\\n]*\\[(?:A-Za-z|a-zA-Z|a-z|A-Z)\\]"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:5.2",
    "std:NIST_800-53:IA-5",
    "std:ISO27001:A.5.17",
    "std:SOC2:CC6.1",
    "std:CMMC:IA.L2-3.5.7",
    "std:PCI_DSS_4:8.3.6",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(5)(ii)(D)",
    "std:HIPAA:164.312(d)",
    "std:NIST_CSF_2:PR.AA-01",
    "cat:password_policy",
    "env:macos",
    "env:host_level",
    "risk:medium"
  ]
}

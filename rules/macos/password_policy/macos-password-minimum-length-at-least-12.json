    "std:SOC2:CC6.1",
    "std:CMMC:IA.L2-3.5.7",
    "std:PCI_DSS_4:8.3.6",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(5)(ii)(D)",
    "std:HIPAA:164.312(d)",
    "std:NIST_CSF_2:PR.AA-01",
    "cat:password_policy",
    "env:macos",
    "env:host_level",
    "risk:high"
  ]

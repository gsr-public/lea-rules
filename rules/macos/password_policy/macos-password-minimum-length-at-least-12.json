{
  "uid": "5f24ac6e-f5d5-4964-a9b1-edda696be006",
  "name": "macOS Password Minimum Length At Least 12",
  "former_names": [
    "macOS Password Minimum Length Policy"
  ],
  "description": "Ensures macOS local password policy requires a minimum length of at least 12 characters, in either the legacy minChars format or the current policyAttributePassword matches '.{12,}' account policy format.",
  "active": true,
  "category": "password_policy",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "pwpolicy getaccountpolicies",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?s)\\\"minChars\\\"[^0-9]*?(?:1[2-9]|[2-9][0-9])\\b|policyAttributePassword matches '\\.\\{(?:1[2-9]|[2-9]\\d|\\d{3}),|<key>minimumLength</key>\\s*<integer>(?:1[2-9]|[2-9]\\d)</integer>"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:5.2",
    "std:NIST_800-53:IA-5",
    "std:ISO27001:A.5.17",

{
  "name": "macOS Password History At Least 15",
  "description": "Ensures the local account policy prevents reuse of the last 15 or more passwords (policyAttributePasswordHistoryDepth). Read from pwpolicy getaccountpolicies (global policy, including policies installed by an MDM profile).",
  "active": true,
  "category": "password_policy",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "pwpolicy getaccountpolicies",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "<key>policyAttributePasswordHistoryDepth</key>\\s*<integer>(?:1[5-9]|[2-9]\\d|[1-9]\\d{2,})</integer>"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:5.2",
    "std:NIST_800-53:IA-5",
    "std:ISO27001:A.5.17",
    "std:SOC2:CC6.1",
    "std:CMMC:IA.L2-3.5.8",
    "std:PCI_DSS_4:8.3.7",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(5)(ii)(D)",
    "std:HIPAA:164.312(d)",
    "std:NIST_CSF_2:PR.AA-01",
    "cat:password_policy",
    "env:macos",
    "env:host_level",
    "risk:medium"
  ]
}

{
  "uid": "70c1152e-b0de-4101-bed2-42600d40f4d9",
  "name": "macOS Diagnostic Data Submission Disabled",
  "description": "Ensures diagnostic and usage data is not submitted automatically (com.apple.SubmitDiagInfo AutoSubmit = false). Reads the effective value of AutoSubmit in the com.apple.SubmitDiagInfo domain (including settings delivered by an MDM configuration profile) through NSUserDefaults; an unset value fails.",
  "active": true,
  "category": "system_hardening",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "/usr/bin/osascript -l JavaScript -e '$.NSUserDefaults.alloc.initWithSuiteName(\"com.apple.SubmitDiagInfo\").objectForKey(\"AutoSubmit\").js'",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\A\\s*(?:false|0)\\s*\\Z"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:NIST_800-53:CM-7",
    "std:ISO27001:A.5.34",
    "std:ISO27001:A.8.12",
    "std:SOC2:CC6.7",
    "std:CMMC:CM.L2-3.4.6",
    "std:NIS2:Art21.2(e)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(1)(ii)(B)",
    "std:NIST_CSF_2:PR.PS-01",
    "cat:system_hardening",
    "env:macos",
    "env:host_level",
    "risk:low"
  ]
}

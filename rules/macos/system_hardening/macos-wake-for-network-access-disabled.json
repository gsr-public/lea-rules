{
  "name": "macOS Wake for Network Access Disabled",
  "description": "Ensures the Mac does not wake for network access (pmset womp 0), so it cannot be woken remotely outside business hours.",
  "active": true,
  "category": "system_hardening",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "pmset -g",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\S"
        },
        "not_re": {
          "stdout": "(?m)^[ \\t]*womp[ \\t]+1\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.1",
    "std:NIST_800-53:CM-6",
    "std:ISO27001:A.8.9",
    "std:SOC2:CC7.1",
    "std:CMMC:CM.L2-3.4.2",
    "std:PCI_DSS_4:2.2.6",
    "std:NIS2:Art21.2(e)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(1)(ii)(B)",
    "std:NIST_CSF_2:PR.PS-01",
    "cat:system_hardening",
    "env:macos",
    "env:host_level",
    "risk:low"
  ]
}

{
  "name": "macOS Security Responses Installed Automatically",
  "description": "Ensures macOS automatically installs Rapid Security Responses and system data files (CriticalUpdateInstall = 1 in /Library/Preferences/com.apple.SoftwareUpdate). Settings delivered only through an MDM configuration profile are stored elsewhere and are not read by this rule.",
  "active": true,
  "category": "system_hardening",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "defaults read /Library/Preferences/com.apple.SoftwareUpdate CriticalUpdateInstall",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\A1\\s*\\Z"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:7.3",
    "std:NIST_800-53:SI-2",
    "std:ISO27001:A.8.8",
    "std:SOC2:CC7.1",
    "std:CMMC:SI.L2-3.14.1",
    "std:PCI_DSS_4:6.3.3",
    "std:NIS2:Art21.2(e)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(1)(ii)(B)",
    "std:NIST_CSF_2:ID.RA-01",
    "std:NIST_CSF_2:PR.PS-02",
    "cat:system_hardening",
    "env:macos",
    "env:host_level",
    "risk:high"
  ]
}

{
  "uid": "1fc4f7af-f266-4a63-aaf0-2f745595f4e1",
  "name": "macOS Account Lockout After 5 or Fewer Failed Logins",
  "description": "Ensures the local account policy locks an account after at most 5 failed authentication attempts (policyAttributeMaximumFailedAuthentications 1-5). Read from pwpolicy getaccountpolicies (global policy, including policies installed by an MDM profile).",
  "active": true,
  "category": "authentication",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "pwpolicy getaccountpolicies",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "<key>policyAttributeMaximumFailedAuthentications</key>\\s*<integer>[1-5]</integer>"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.10",

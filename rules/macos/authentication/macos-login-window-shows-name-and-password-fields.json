{
  "name": "macOS Login Window Shows Name and Password Fields",
  "description": "Ensures the login window asks for both user name and password instead of listing accounts (SHOWFULLNAME = true). Reads the effective value of SHOWFULLNAME in the com.apple.loginwindow domain (including settings delivered by an MDM configuration profile) through NSUserDefaults; an unset value fails.",
  "active": true,
  "category": "authentication",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "/usr/bin/osascript -l JavaScript -e '$.NSUserDefaults.alloc.initWithSuiteName(\"com.apple.loginwindow\").objectForKey(\"SHOWFULLNAME\").js'",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\A\\s*(?:true|1)\\s*\\Z"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:NIST_800-53:AC-8",
    "std:NIST_800-53:IA-2",
    "std:ISO27001:A.8.5",
    "std:SOC2:CC6.1",
    "std:CMMC:IA.L2-3.5.2",
    "std:PCI_DSS_4:8.3.1",
    "std:NIS2:Art21.2(i)",
    "std:DORA:Art9",
    "std:HIPAA:164.312(a)(2)(i)",
    "std:HIPAA:164.312(d)",
    "std:NIST_CSF_2:PR.AA-03",
    "cat:authentication",
    "env:macos",
    "env:host_level",
    "risk:low"
  ]
}

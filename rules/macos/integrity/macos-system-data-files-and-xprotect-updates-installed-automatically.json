{
  "name": "macOS System Data Files and XProtect Updates Installed Automatically",
  "description": "Ensures XProtect, MRT and other system data files are installed automatically (ConfigDataInstall = true). Reads the effective value of ConfigDataInstall in the com.apple.SoftwareUpdate domain (including settings delivered by an MDM configuration profile) through NSUserDefaults; an unset value fails.",
  "active": true,
  "category": "integrity",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "/usr/bin/osascript -l JavaScript -e '$.NSUserDefaults.alloc.initWithSuiteName(\"com.apple.SoftwareUpdate\").objectForKey(\"ConfigDataInstall\").js'",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\A\\s*(?:true|1)\\s*\\Z"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:10.1",
    "std:CIS_Controls_v8:10.2",
    "std:NIST_800-53:SI-2",
    "std:NIST_800-53:SI-3",
    "std:ISO27001:A.8.7",
    "std:SOC2:CC6.8",
    "std:CMMC:SI.L2-3.14.2",
    "std:PCI_DSS_4:5.2.1",
    "std:NIS2:Art21.2(g)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(1)(ii)(B)",
    "std:HIPAA:164.308(a)(5)(ii)(B)",
    "std:NIST_CSF_2:DE.CM-09",
    "std:NIST_CSF_2:ID.RA-01",
    "std:NIST_CSF_2:PR.PS-02",
    "cat:integrity",
    "env:macos",
    "env:host_level",
    "risk:high"
  ]
}

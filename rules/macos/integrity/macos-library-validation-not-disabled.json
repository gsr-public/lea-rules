{
  "name": "macOS Library Validation Not Disabled",
  "description": "Ensures library validation is not disabled system-wide (com.apple.security.libraryvalidation DisableLibraryValidation = false), so processes only load libraries signed by Apple or the same team. Reads the effective value of DisableLibraryValidation in the com.apple.security.libraryvalidation domain (including settings delivered by an MDM configuration profile) through NSUserDefaults; an unset value fails.",
  "active": true,
  "category": "integrity",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "/usr/bin/osascript -l JavaScript -e '$.NSUserDefaults.alloc.initWithSuiteName(\"com.apple.security.libraryvalidation\").objectForKey(\"DisableLibraryValidation\").js'",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\A\\s*(?:false|0)\\s*\\Z"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:10.5",
    "std:NIST_800-53:CM-6",
    "std:NIST_800-53:SI-7",
    "std:NIST_800-53:SI-16",
    "std:ISO27001:A.8.9",
    "std:SOC2:CC6.8",
    "std:CMMC:CM.L2-3.4.2",
    "std:PCI_DSS_4:2.2.6",
    "std:NIS2:Art21.2(e)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(1)(ii)(B)",
    "std:HIPAA:164.312(c)(1)",
    "std:NIST_CSF_2:DE.CM-09",
    "std:NIST_CSF_2:PR.DS-01",
    "std:NIST_CSF_2:PR.PS-01",
    "cat:integrity",
    "env:macos",
    "env:host_level",
    "risk:medium"
  ]
}

{
  "name": "macOS AirDrop Disabled",
  "description": "Ensures AirDrop is disabled by configuration profile (com.apple.applicationaccess allowAirDrop = false), preventing ad hoc file transfer to unmanaged devices. Reads the effective value of allowAirDrop in the com.apple.applicationaccess domain (including settings delivered by an MDM configuration profile) through NSUserDefaults; an unset value fails.",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "/usr/bin/osascript -l JavaScript -e '$.NSUserDefaults.alloc.initWithSuiteName(\"com.apple.applicationaccess\").objectForKey(\"allowAirDrop\").js'",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\A\\s*(?:false|0)\\s*\\Z"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.8",
    "std:NIST_800-53:CM-7",
    "std:ISO27001:A.5.34",
    "std:ISO27001:A.8.12",
    "std:SOC2:CC6.7",
    "std:CMMC:CM.L2-3.4.6",
    "std:NIS2:Art21.2(e)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(1)(ii)(B)",
    "std:NIST_CSF_2:PR.PS-01",
    "cat:network_security",
    "env:macos",
    "env:host_level",
    "risk:medium"
  ]
}

  "name": "macOS UUCP Service Disabled",
  "description": "Ensures the legacy UUCP service is disabled. Passes when launchd lists \"com.apple.uucp\" as disabled in the system domain.\nRequired sudo rule: allow user lea to run ONLY this exact command without a password: lea ALL=(root) NOPASSWD: /bin/launchctl print-disabled system",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "launchctl print-disabled system",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "\"com\\.apple\\.uucp\"[ \\t]*=>[ \\t]*(?:disabled|true)\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },

{
  "name": "macOS Firewall Stealth Mode Enabled",
  "description": "Ensures the macOS Application Firewall stealth mode is on, so the host does not answer ICMP pings or connection attempts to closed ports.",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "/usr/libexec/ApplicationFirewall/socketfilterfw --getstealthmode",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?i)stealth mode (?:is )?(?:on|enabled)\\b"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.4",
    "std:CIS_Controls_v8:4.5",
    "std:NIST_800-53:SC-7",
    "std:ISO27001:A.8.20",
    "std:SOC2:CC6.6",
    "std:CMMC:SC.L2-3.13.1",
    "std:CMMC:SC.L2-3.13.6",
    "std:PCI_DSS_4:1.3.1",
    "std:PCI_DSS_4:1.5.1",
    "std:NIS2:Art21.2(e)",
    "std:DORA:Art9",
    "cat:network_security",
    "env:macos",
    "env:host_level",
    "risk:medium"
  ]

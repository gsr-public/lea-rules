{
  "name": "macOS Bonjour Advertising Disabled",
  "description": "Ensures the mDNSResponder does not advertise services over multicast DNS (NoMulticastAdvertisements = true). Reads the effective value of NoMulticastAdvertisements in the com.apple.mDNSResponder domain (including settings delivered by an MDM configuration profile) through NSUserDefaults; an unset value fails.",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "/usr/bin/osascript -l JavaScript -e '$.NSUserDefaults.alloc.initWithSuiteName(\"com.apple.mDNSResponder\").objectForKey(\"NoMulticastAdvertisements\").js'",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "\\A\\s*(?:true|1)\\s*\\Z"
        }
      }
    ],
    "remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.4",
    "std:CIS_Controls_v8:4.8",
    "std:NIST_800-53:CM-7",
    "std:NIST_800-53:SC-7",
    "std:ISO27001:A.8.9",
    "std:ISO27001:A.8.20",
    "std:SOC2:CC6.6",
    "std:CMMC:CM.L2-3.4.7",
    "std:CMMC:SC.L2-3.13.1",
    "std:PCI_DSS_4:1.3.1",
    "std:PCI_DSS_4:2.2.4",
    "std:NIS2:Art21.2(e)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(1)(ii)(B)",
    "std:HIPAA:164.312(e)(1)",
    "std:NIST_CSF_2:PR.IR-01",
    "std:NIST_CSF_2:PR.PS-01",
    "cat:network_security",
    "env:macos",
    "env:host_level",
    "risk:low"
  ]
}

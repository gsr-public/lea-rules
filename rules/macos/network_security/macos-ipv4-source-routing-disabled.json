{
  "name": "macOS IPv4 Source Routing Disabled",
  "description": "Ensures the macOS kernel parameter net.inet.ip.sourceroute is disabled (0), preventing processing of IPv4 source-routed packets that can be used to bypass routing controls.\nRequired sudo rule: allow user lea to run ONLY this exact command without a password:\nlea ALL=(root) NOPASSWD: /usr/sbin/sysctl net.inet.ip.sourceroute=0",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "sysctl net.inet.ip.sourceroute",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^net\\.inet\\.ip\\.sourceroute:\\s*0\\s*$"
        }
      }
    ],
    "remedy": [
      {
        "command": "sysctl net.inet.ip.sourceroute=0 >/dev/null && sysctl net.inet.ip.sourceroute",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.1",
    "std:NIST_800-53:SC-7",
    "std:ISO27001:A.8.20",
    "std:SOC2:CC6.6",
    "std:CMMC:SC.L2-3.13.1",
    "std:PCI_DSS_4:1.4.3",
    "std:PCI_DSS_4:2.2.6",
    "std:NIS2:Art21.2(e)",
    "std:DORA:Art9",
    "cat:network_security",
    "env:macos",
    "env:host_level",
    "risk:medium",
    "priv:required"
  ]
}

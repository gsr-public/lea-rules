{
  "name": "macOS Application Firewall Enabled",
  "description": "Checks that the macOS Application Firewall is enabled.",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "/usr/libexec/ApplicationFirewall/socketfilterfw --getglobalstate",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)Firewall is enabled\\b"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.4",
    "std:CIS_Controls_v8:4.5",
    "std:NIST_800-53:AC-4",
    "std:NIST_800-53:SC-7",
    "std:ISO27001:A.8.20",
    "std:ISO27001:A.13.1.1",
    "std:SOC2:CC6.6",
    "std:CMMC:SC.L2-3.13.1",
    "std:CMMC:SC.L2-3.13.6",
    "std:PCI_DSS_4:1.3.1",
    "std:PCI_DSS_4:1.5.1",
    "std:NIS2:Art21.2(e)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(1)(ii)(B)",
    "std:HIPAA:164.312(e)(1)",

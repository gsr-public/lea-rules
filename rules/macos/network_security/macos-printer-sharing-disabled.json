{
  "name": "macOS Printer Sharing Disabled",
  "description": "Ensures CUPS printer sharing is disabled (cupsctl reports _share_printers=0).",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "cupsctl",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^_share_printers=0$"
        }
      }
    ],
    "_remedy": [],
    "system": []
  },
  "parameters": [],

{
  "name": "macOS IPv6 ICMP Redirects Not Accepted",
  "description": "Ensures the macOS kernel parameter net.inet6.icmp6.rediraccept is disabled (0), preventing acceptance of IPv6 ICMP redirect messages that can alter routing tables.\nRequired sudo rule (remedy only): allow user lea to run ONLY this exact command without a password: lea ALL=(root) NOPASSWD: /usr/sbin/sysctl net.inet6.icmp6.rediraccept=0",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "sysctl net.inet6.icmp6.rediraccept",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^net\\.inet6\\.icmp6\\.rediraccept:\\s*0\\s*$"
        }
      }
    ],
    "remedy": [
      {
        "command": "sysctl net.inet6.icmp6.rediraccept=0 >/dev/null && sysctl net.inet6.icmp6.rediraccept",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.1",
    "std:NIST_800-53:SC-7",
    "std:ISO27001:A.8.20",
    "std:SOC2:CC6.6",
    "std:CMMC:SC.L2-3.13.1",
    "std:PCI_DSS_4:1.4.3",
    "std:PCI_DSS_4:2.2.6",
    "std:NIS2:Art21.2(e)",
    "std:DORA:Art9",
    "std:HIPAA:164.308(a)(1)(ii)(B)",
    "std:HIPAA:164.312(e)(1)",
    "std:NIST_CSF_2:PR.IR-01",
    "cat:network_security",
    "env:macos",
    "env:host_level",
    "risk:medium"
  ]
}

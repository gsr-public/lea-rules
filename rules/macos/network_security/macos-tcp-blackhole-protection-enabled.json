{
  "name": "macOS TCP Blackhole Protection Enabled",
  "description": "Ensures the macOS kernel parameter net.inet.tcp.blackhole is configured to aggressively drop unsolicited TCP traffic to closed ports (1 or 2), reducing information leakage and mitigating simple port scanning.\nRequired sudo rule: allow user lea to run ONLY this exact command without a password:\nlea ALL=(root) NOPASSWD: /usr/sbin/sysctl net.inet.tcp.blackhole=2",
  "active": true,
  "category": "network_security",
  "cycle": 3600,
  "cmd_info_key": null,
  "cmd": {
    "validation": [
      {
        "command": "sysctl net.inet.tcp.blackhole",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "expect": [
      {
        "system": [
          "Darwin"
        ],
        "distribution": [],
        "re": {
          "stdout": "(?m)^net\\.inet\\.tcp\\.blackhole:\\s*(1|2)\\s*$"
        }
      }
    ],
    "remedy": [
      {
        "command": "sysctl net.inet.tcp.blackhole=2 >/dev/null && sysctl net.inet.tcp.blackhole",
        "system": [
          "Darwin"
        ],
        "distribution": []
      }
    ],
    "system": []
  },
  "parameters": [],
  "tags": [
    "std:CIS",
    "std:CIS_Controls_v8:4.1",
    "std:NIST_800-53:SC-7",
    "std:ISO27001:A.8.20",
    "std:SOC2:CC6.6",
    "std:CMMC:SC.L2-3.13.1",
    "std:PCI_DSS_4:2.2.6",
    "std:NIS2:Art21.2(e)",
    "std:DORA:Art9",
    "cat:network_security",
    "env:macos",
    "env:host_level",
    "risk:medium",
    "priv:required"
  ]
}
